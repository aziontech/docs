+  // The tip teleports to <body>, and an SSR host that does not re-emit Vue's teleport
+  // payload into the served markup (Astro is one) leaves the client hydrating the
+  // page's own first body child where it expects the teleport anchor -- a hydration
+  // node mismatch on every documentation page that hydrates this component. Teleporting
+  // only once mounted keeps the server render and the client's first render identical:
+  // the tip is a v-if comment inline in the root either way. Nothing is lost by
+  // waiting -- the tip only ever opens on pointerover, which is after mount.
+  const isMounted = ref(false)
+
+  onMounted(() => {
+    isMounted.value = true
+  })
+
   onBeforeUnmount(() => {
