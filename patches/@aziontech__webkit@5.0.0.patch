diff --git a/src/composables/use-mounted/index.ts b/src/composables/use-mounted/index.ts
new file mode 100644
index 0000000..c4816ed
--- /dev/null
+++ b/src/composables/use-mounted/index.ts
@@ -0,0 +1,22 @@
+import { onMounted, ref, type Ref } from 'vue'
+
+/**
+ * Whether the component has mounted on the client.
+ *
+ * An overlay that teleports to <body> needs this: an SSR host that does not
+ * re-emit Vue's teleport payload into the served markup (Astro is one) leaves
+ * the client hydrating the page's own first body child where it expects the
+ * teleport anchor, a hydration mismatch on every page that hydrates the
+ * component. Rendering the teleport `:disabled="!isMounted"` keeps the server
+ * render and the client's first render identical; the overlay only ever opens
+ * on an interaction, which is after mount, so nothing is lost by waiting.
+ */
+export function useMounted(): Ref<boolean> {
+  const isMounted = ref(false)
+
+  onMounted(() => {
+    isMounted.value = true
+  })
+
+  return isMounted
+}
