{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aziontech/docs/blob/main/deployments/schema.json",
  "title": "Azion docs production deployment manifest",
  "description": "What is deployed to production, written by CI through the promotion pull request. Stage has no manifest here: it is recorded with the GitHub Deployments API, because main is protected by a ruleset and CI cannot write to it. See deployments/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "state",
    "release",
    "build",
    "deploy",
    "stage",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environment": {
      "const": "production"
    },
    "state": {
      "description": "unknown = bootstrap, never written by a pipeline run; ready = promotion approved, deploy pending; deployed = a green deploy wrote this file.",
      "enum": ["unknown", "ready", "deployed"]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "gitTag", "sourceCommit", "githubReleaseUrl"],
      "properties": {
        "version": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "gitTag": {
          "type": ["string", "null"],
          "pattern": "^docs-v\\d+\\.\\d+\\.\\d+$"
        },
        "sourceCommit": {
          "description": "The promoted unit. The build is redone per environment, so this pair (gitTag + sourceCommit) is the identity that travels, not a binary.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "githubReleaseUrl": {
          "type": ["string", "null"],
          "pattern": "^https://"
        }
      }
    },
    "build": {
      "description": "Inputs pinned at build time. A rollback rebuilds from the tag and needs these to reconstruct under the same conditions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "cliVersion", "configDir"],
      "properties": {
        "nodeVersion": {
          "type": ["string", "null"]
        },
        "cliVersion": {
          "type": ["string", "null"]
        },
        "configDir": {
          "type": ["string", "null"],
          "pattern": "^apps/docs/azion/production$"
        }
      }
    },
    "deploy": {
      "description": "The run that put this release in production.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "requestedBy",
        "previousVersion",
        "reason",
        "workflowRunId",
        "workflowRunAttempt",
        "workflowRunUrl",
        "deployedAt"
      ],
      "properties": {
        "trigger": {
          "enum": ["release", "rollback", "manual", "bootstrap"]
        },
        "requestedBy": {
          "type": ["string", "null"]
        },
        "previousVersion": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "reason": {
          "description": "Required on rollback; null otherwise.",
          "type": ["string", "null"]
        },
        "workflowRunId": {
          "type": ["integer", "null"]
        },
        "workflowRunAttempt": {
          "type": ["integer", "null"]
        },
        "workflowRunUrl": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "deployedAt": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    },
    "stage": {
      "description": "The GitHub deployment record that vouches for this release on stage. Read back from the Deployments API at promotion time (GET /deployments?environment=stage&ref=<gitTag>), which is also the promotion gate: no green stage deployment for this exact tag, no promotion.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "gitTag", "sourceCommit", "state", "logUrl", "deployedAt"],
      "properties": {
        "deploymentId": {
          "type": ["integer", "null"]
        },
        "gitTag": {
          "type": ["string", "null"],
          "pattern": "^docs-v\\d+\\.\\d+\\.\\d+$"
        },
        "sourceCommit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "state": {
          "enum": ["success", null]
        },
        "logUrl": {
          "type": ["string", "null"],
          "pattern": "^https://"
        },
        "deployedAt": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "instructions"],
      "properties": {
        "mechanism": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    }
  }
}
