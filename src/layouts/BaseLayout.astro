---
import type { CollectionEntry } from 'astro:content';

import HeadCommon from '~/components/HeadCommon.astro';
import HeadSEO from '~/components/HeadSEO.astro';
import LeftSidebar from '~/components/LeftSidebar/LeftSidebar.astro';
import GoogleTagManagerIframe from '~/components/trd3/google/tagmanager-iframe.astro';
import Trd3 from '~/components/html/trd3.astro';
import Analytics from '~/components/tracking/Analytics.astro';

import { ANALYTICS_PROXY_URL, ANALYTICS_WRITE_KEY } from '~/consts';

// @ts-nocheck
import Header from '~/components/Header.vue';
import Footer from '~/components/Footer.vue';
import HeaderSearchDialog from '~/components/webkit/HeaderSearchDialog.vue';
import HeaderRightSidebar from '~/components/webkit/HeaderRightSidebar.vue';
import DocsTopNav from '~/components/webkit/DocsTopNav.vue';
import SystemStatus from '~/components/webkit/SystemStatus.vue';
import SelectLang from '~/components/webkit/SelectLang.vue';
import ThemeSwitcher from '~/components/webkit/DropdownThemeSwitcher.vue';

import { getLanguageFromURL, normalizeCanonicalPath } from '~/util';
// import { getPageCategory } from '~/util/getPageCategory';
import { getTranslatedPagesByNamespace } from '~/util/getPageTranslations';
import { getHeaderMenuStrings, getFooterMenuStrings } from '~/i18n/translations';

import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { rtlLanguages } from '~/i18n/languages';
import { useTranslations } from '~/i18n/util';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
}

import '@aziontech/icons'
import '~/styles/main.css';

const { content } = Astro.props;
// A layout that fills `secondary-sidebar` gets the rail and the third grid track;
// one that does not (the docs home) gets neither, so no dead gutter is reserved.
const hasSecondarySidebar = Astro.slots.has('secondary-sidebar');
const isFallback = !!Astro.params.fallback;
const url = Astro.url;
const lang = getLanguageFromURL(url.pathname);
const direction = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
const bcpLang = normalizeLangTag(lang);
const currentPage = url.pathname;
const t = useTranslations(Astro);
import { getDirectory, getSidebar, getTopNav, type Lang } from '~/nav/index';

const sidebar = await getSidebar(currentPage, lang as Lang, { allProducts: t('leftSidebar.allProducts') });
const topNav = await getTopNav(lang as Lang);
const topNavLabels = {
	products: t('topNav.products'),
	guides: t('topNav.guides'),
	devtools: t('topNav.devtools'),
};
const directoryGroups = await getDirectory(lang as Lang, topNavLabels);

// The sticky column a rail scrolls inside: the height left under the bar, which is
// webkit's GlobalHeader at h-14 (--spacing-14). `sidebar` stays in the list because the
// analytics click handler keys docs-navigation off it (see Analytics.astro).
const SIDEBAR_COLUMN =
	'sidebar sticky top-(--spacing-14) h-[calc(100dvh-var(--spacing-14))]';

const {
	menuSecondaryMobile,
	bottomButtonsMobile,
	algoliaIndex,
	algoliaModel,
	algoliaInputPlaceholder,
} = getHeaderMenuStrings(currentPage);

const {
	listData,
	socialButtons
} = getFooterMenuStrings(currentPage);

const formatTitle = (content: { title?: string }) => {
  return (content.title && content.title.trim().length > 0)
    ? `${content.title.trim()} - ${t('site.title')}`
    : t('site.title');
};
// Ensures canonical URLs collapse repeated slashes and always keep a single trailing slash.
const canonicalURL = new URL(normalizeCanonicalPath(Astro.url.pathname), Astro.site);
if (isFallback) canonicalURL.pathname = canonicalURL.pathname.replace(`/${lang}/`, '/en/');

const translatedPages = await (async (c) => {
	return c.namespace ? await getTranslatedPagesByNamespace(c.namespace) : [];
})(content);
---
<html dir={direction} lang={bcpLang} class="azion dark azion-dark">
	<head>
		<HeadCommon />
		<HeadSEO {translatedPages} {content} {canonicalURL} />
		<title set:html={formatTitle(content)} />

	</head>

	<body class="bg-canvas">
		<GoogleTagManagerIframe />

		<script is:inline>
			const setTheme = (theme) => {
				const html = document.documentElement
				
				const applyDarkMode = () => {
					html.classList.add('dark', 'azion-dark')
					html.classList.remove('azion-light')
				}
				
				const applyLightMode = () => {
					html.classList.remove('dark', 'azion-dark')
					html.classList.add('azion-light')
				}
		
				if (theme === 'Light') {
					applyLightMode()
					return
				}
		
				if (theme === 'Dark') {
					applyDarkMode()
					return
				}
		
				// System preference (default)
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					applyDarkMode()
				} else {
					applyLightMode()
				}
			}
			
			const currentTheme = localStorage.getItem("prefers-color-scheme")
			setTheme(currentTheme)
			
			const originalSetItem = localStorage.setItem
			localStorage.setItem = function(key, value) {
				originalSetItem.call(this, key, value)
				if (key === 'prefers-color-scheme') {
					setTheme(value)
				}
			}
			
			window.addEventListener('storage', (event) => {
				if (event.key === 'prefers-color-scheme') {
					setTheme(event.newValue)
				}
			})
		</script>
		<Header homeHref={`/${lang}/`} signInLabel={t('topNav.signIn')}>
			<Fragment slot="nav">
					<DocsTopNav
						client:idle
						products={topNav?.products ?? []}
						devtools={topNav?.devtools ?? []}
						guides={topNav?.guides ?? null}
						labels={topNavLabels}
						ariaLabel={t('topNav.a11yTitle')}
					/>
			</Fragment>

			<Fragment slot="mobile-nav">
					<HeaderRightSidebar
						class="py-(--spacing-xl)"
						client:idle
						menuSecondary={menuSecondaryMobile}
						bottomButtons={bottomButtonsMobile}
						menuGroups={sidebar.groups}
						menuActiveId={sidebar.activeId}
						menuExpanded={sidebar.expandedIds}
						menuHeader={sidebar.header}
						menuFilterPlaceholder={t('leftSidebar.filter')}
						menuNoMatchesLabel={t('leftSidebar.noMatches')}
						menuAriaLabel={t('leftSidebar.a11yTitle')}
						directoryGroups={directoryGroups}
						directoryAriaLabel={t('topNav.a11yTitle')}
					/>
			</Fragment>

			<Fragment slot="dialog">
						<HeaderSearchDialog
							client:only="vue"
							algoliaAppId="PYJUZH6VNQ"
							algoliaApiKey="7c1795c333053265edd2aeb199745797"
							algoliaIndex={algoliaIndex}
							algoliaModel={algoliaModel}
							inputPlaceholder={algoliaInputPlaceholder}
						/>
			</Fragment>
		</Header>
		<main class="flex min-h-0">
			<!-- NO GAP between the columns. Each rail draws its own hairline — the webkit
			     Sidebar's `border-r`, the outline's `border-l` — so a gap would set the
			     columns off from a rule that already separates them. `shrink-0` because the
			     rail's width is the Sidebar's to decide (seeded at --container-2xs, then
			     driven by its drag handle and collapse). -->
			<aside
				id="left-sidebar"
				class="hidden shrink-0 lg:block"
			>
				<div class={SIDEBAR_COLUMN}>
					<LeftSidebar sidebar={sidebar} />
				</div>
			</aside>

			<div id="main-content" class="flex min-h-0 min-w-0 flex-1 flex-col">
				<slot />
				<Footer
					client:visible
					{lang}
					{listData}
					{socialButtons}
				>
					<Fragment slot="action">
						<SelectLang
							{lang}
							i18nPages={translatedPages.map((page) => {
								return {
									langPrefix: page.lang,
									slug: `/${page.lang}/${page.slug}/`,
									lang: page.lang === 'pt-br' ? 'Português' : 'English'
								};
							})}
							client:visible={{rootMargin: "600px"}}
						/>
					</Fragment>
					<Fragment slot="system-status">
						<SystemStatus
							{lang}
							client:visible={{rootMargin: "600px"}}
						/>
					</Fragment>
					<Fragment slot="theme-switch">
						<ThemeSwitcher client:visible={{rootMargin: "600px"}} />
					</Fragment>
				</Footer>
			</div>

			{
				hasSecondarySidebar && (
					<aside
						id="right-sidebar"
						class="hidden w-(--container-3xs) shrink-0 border-l border-(--border-default) xl:block"
					>
						<div class={SIDEBAR_COLUMN}>
							<slot name="secondary-sidebar" />
						</div>
					</aside>
				)
			}
		</main>

		<Trd3 />
		<Analytics ANALYTICS_PROXY_URL={ANALYTICS_PROXY_URL} ANALYTICS_WRITE_KEY={ANALYTICS_WRITE_KEY} />
	</body>

</html>

