---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

import PageContent from '~/components/PageContent/PageContent.astro';
import RightSidebar from '~/components/RightSidebar/RightSidebar.astro';

import { getGithubEditUrl } from '~/util/getGithubEditUrl';
// import generateToc from '~/util/generateToc';
import { getLanguageFromURL } from '~/util';
import { getNeighbours, type Lang } from '~/nav/index';

import BaseLayout from '~/layouts/BaseLayout.astro';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
	headings: MarkdownHeading[];
	id?: String;
	/** Set by pages outside the `docs` collection, for the GitHub edit link. */
	editFilePath?: string;
}

const { content, headings } = Astro.props;

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const { previous, next } = await getNeighbours(Astro.url.pathname, lang);
const githubEditUrl = getGithubEditUrl(Astro);
---

<BaseLayout {...Astro.props}>
	<RightSidebar slot="secondary-sidebar" {...{ content, headings, githubEditUrl }} />

	<PageContent {...{ content, previous, next }}>
		<!-- <Fragment slot="before-article"></Fragment> -->
		<slot />
	</PageContent>
</BaseLayout>
