---
/** The layout for the documentation home, and only for it. */
// Not `MainLayout`: the home is card grids, not prose, so the "On this page" rail has
// nothing to index — filling no `secondary-sidebar` slot is what drops it.
// Not `PageContent` either, which is the READING shell (masthead banner, prose column,
// closing `hr`). The home carries its own masthead as the column's first block, so it
// opens under the docs top bar; it keeps the column and the closing next pair, so the
// shell does not change under a reader following their first link out.
// `docs-home` opens the section step to 64 / 96 — see src/styles/main.css.
import type { CollectionEntry } from 'astro:content';

import DocPagination from '@aziontech/webkit/doc-pagination';

import ReadableContent from '~/components/webkit/ReadableContent.vue';
import BaseLayout from '~/layouts/BaseLayout.astro';

import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { rtlLanguages } from '~/i18n/languages';
import { useTranslations } from '~/i18n/util';
import { getLanguageFromURL } from '~/util';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
	id?: String;
	/** Set by pages outside the `docs` collection, for the GitHub edit link. */
	editFilePath?: string;
	/** The `next` half of the closing pair; the home has no previous. */
	next?: { title: string; href: string };
}

/**
 * THE PAGE HAS ONE COLUMN, AND IT IS WRITTEN ONCE. The closing pair used to carry
 * `px-container` — a 4xl measure with its own gutter — while the content above it took
 * the site measure, so "Next page" sat ~35px inside the last card it followed. Both
 * blocks read this constant now, so neither can drift from the other again.
 */
const COLUMN = 'layout-boundary-inline mx-auto w-full max-w-(--layout-measure-site)';

const { next } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname);
const direction = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
const bcpLang = normalizeLangTag(lang);
const t = useTranslations(Astro);
---

<BaseLayout {...Astro.props}>
	<div dir={direction} lang={bcpLang}>
		{
			/*
			 * Every step below is a theme token: the semantic `--spacing-*` scale tops out at
			 * `xxl` (32), and the home's section step is 64 / 96 — the next two rungs of the
			 * theme's own primitive ladder, named as `--spacing-16` / `--spacing-24` rather
			 * than left as bare Tailwind numbers that resolve to the same place by luck.
			 */
		}
		<article class="docs-home pb-(--spacing-16) sm:pb-(--spacing-24)">
			<section
				class:list={[
					COLUMN,
					'pt-(--spacing-16) pb-(--spacing-16) sm:pt-(--spacing-24) sm:pb-(--spacing-24)',
				]}
			>
				<ReadableContent client:load>
					<slot />
				</ReadableContent>
			</section>

			{
				/*
				 * The pair is placed by its wrapper, not restyled: the column is the wrapper's
				 * job and the row inside it stays the design system's. Its own top step is
				 * kept as it was — note it lands UNDER the section's `pb`, so the gap above
				 * the pair is 96 + 64, not one section step.
				 */
				next && (
					<div class:list={[COLUMN, 'pt-(--spacing-16)']}>
						<DocPagination next={next} nextLabel={t('articleNav.nextPage')} />
					</div>
				)
			}
		</article>
	</div>
</BaseLayout>
