---
/**
 * The layout for the documentation home, and only for it.
 *
 * It is deliberately NOT `MainLayout`: the home is a set of card grids, not
 * prose, so the "On this page" rail has nothing useful to index. Filling no
 * `secondary-sidebar` slot is what tells `BaseLayout` to drop the rail and
 * collapse its grid track, so the content re-centres instead of sitting beside
 * an empty gutter.
 *
 * Every other documentation page keeps `MainLayout` and its rail.
 */
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import PageContent from '~/components/PageContent/PageContent.astro';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
	id?: String;
	/** Set by pages outside the `docs` collection, for the GitHub edit link. */
	editFilePath?: string;
}

const { content } = Astro.props;
---

<BaseLayout {...Astro.props}>
	<PageContent {content}>
		<slot />
	</PageContent>
</BaseLayout>
