---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '~/layouts/MainLayout.astro';
import HomepageLayout from './HomepageLayout.astro';
import PricingLayout from './PricingLayout.astro';

export interface Props {
	data: CollectionEntry<'docs'>['data'];
	headings: MarkdownHeading[];
	id: String;
}

const { data, headings, id } = Astro.props;

// Check if this is a pricing page by namespace
const isPricingPage = data.namespace === 'documentation_pricing';
// The documentation home takes the site-wide measure with no rail (see MainLayout `home`).
const isDocsHome = data.namespace === 'documentation_home';
---

{
	data.type === 'homepage' ? (
		<HomepageLayout content={data} headings={headings} id={id}>
			<slot />
		</HomepageLayout>
	) : isPricingPage ? (
		<PricingLayout content={data} headings={headings} id={id}>
			<slot />
		</PricingLayout>
	) : (
		<MainLayout content={data} headings={headings} id={id} home={isDocsHome}>
			<slot />
		</MainLayout>
	)
}
