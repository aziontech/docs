---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '~/layouts/MainLayout.astro';
import DevtoolsHome from '~/components/homes/DevtoolsHome.astro';
import DocsDirectoryLayout from './DocsDirectoryLayout.astro';
import DocsHomeLayout from './DocsHomeLayout.astro';
import HomepageLayout from './HomepageLayout.astro';
import PricingLayout from './PricingLayout.astro';

export interface Props {
	data: CollectionEntry<'docs'>['data'];
	headings: MarkdownHeading[];
	id: String;
}

const { data, headings, id } = Astro.props;

// Check if this is a pricing page by namespace
const isPricingPage = data.namespace === 'documentation_pricing';
// The guides hub is a CATALOG, not a document: it carries its own filter column and a
// card grid, so it takes the directory shell (no docs rail, no outline, no prose
// measure) instead of the reading one. Keyed off the namespace, like pricing above, so
// both language editions of the page switch together.
const isDirectoryPage = data.namespace === 'documentation_how_to';
// The Developer tools home is the documentation home's sibling: its shell (prose contract,
// site column, 64 / 96 section step, the rail on the Developer tools level), and a body
// rendered from src/data/devtools-home and the hub tree, not from the MDX file, which keeps
// only the frontmatter the nav needs. Keyed off the namespace, like the two above.
const isDevtoolsHome = data.namespace === 'documentation_dev_tools_home';
---

{
	data.type === 'homepage' ? (
		<HomepageLayout content={data} headings={headings} id={id}>
			<slot />
		</HomepageLayout>
	) : isPricingPage ? (
		<PricingLayout content={data} headings={headings} id={id}>
			<slot />
		</PricingLayout>
	) : isDirectoryPage ? (
		<DocsDirectoryLayout content={data} headings={headings} id={id}>
			<slot />
		</DocsDirectoryLayout>
	) : isDevtoolsHome ? (
		<DocsHomeLayout content={data} id={id}>
			<DevtoolsHome />
		</DocsHomeLayout>
	) : (
		<MainLayout content={data} headings={headings} id={id}>
			<slot />
		</MainLayout>
	)
}
