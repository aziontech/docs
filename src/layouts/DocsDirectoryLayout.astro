---
/** The layout for a DIRECTORY page — a page that IS a catalog, not a document. */
// Three pieces of the reading shell are wrong for one, and each is dropped here: the docs
// rail (`primarySidebar={false}` — the page's own filter column is the navigation), the
// "On this page" outline (no `secondary-sidebar` slot, so no third track is reserved), and
// `PageContent`'s prose measure (3xl, the one width a card grid must not take). The docs
// container stays, so the shell holds under the first link out. The closing prev/next pair
// does not: it walks a reading SEQUENCE, and a catalog is the thing you pick from, not a
// page in one — "Next page" under 351 cards names a neighbour nobody was reading toward.
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';

import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { rtlLanguages } from '~/i18n/languages';
import { getLanguageFromURL } from '~/util';
import type { Lang } from '~/nav/index';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
	headings?: MarkdownHeading[];
	id?: String;
	/** Set by pages outside the `docs` collection, for the GitHub edit link. */
	editFilePath?: string;
}

/** The docs home's column, to the pixel — the two hubs open on the same measure. */
const COLUMN = 'layout-boundary-inline mx-auto w-full max-w-(--layout-measure-site)';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const direction = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
const bcpLang = normalizeLangTag(lang);
---

<BaseLayout {...Astro.props} primarySidebar={false}>
	<div dir={direction} lang={bcpLang}>
		<article class="pb-(--spacing-16) sm:pb-(--spacing-24)">
			<section class:list={[COLUMN, 'pt-(--spacing-16) sm:pt-(--spacing-24)']}>
				<slot />
			</section>
		</article>
	</div>
</BaseLayout>
