---
import DocCallout from '@aziontech/webkit/doc-callout';

export interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger';
	title?: string;
}

const { type = 'note', title } = Astro.props as Props;

const kindMap = {
	note: 'note',
	tip: 'tip',
	caution: 'warning',
	danger: 'danger',
} as const;
const kind = kindMap[type] ?? 'note';

const escapeHtml = (value: string) =>
	value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

let body = (await Astro.slots.render('default')).trim();
body = body
	.replace(/<\/p>\s*<p>/g, '<br /><br />')
	.replace(/^<p>/, '')
	.replace(/<\/p>$/, '');

if (title) {
	body = `${escapeHtml(title)} — ${body}`;
}
---
<DocCallout kind={kind}>
	<Fragment set:html={body} />
</DocCallout>
