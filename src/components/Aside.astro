---
import DocCallout from '@aziontech/webkit/doc-callout';

/**
 * Adapter over webkit's `doc-callout`, keeping the `:::note` remark pipeline's
 * contract (`type` + optional `title`) so no authored content changes.
 *
 * What the DS owns: the whole admonition surface — severity tint, border,
 * glyph, radius, copy ink, link/code-chip treatment (see doc-callout.vue).
 *
 * What this wrapper adds, and why:
 * - Kind mapping: authored variants are `note|tip|caution|danger`; webkit's
 *   are `note|info|tip|check|warning|danger`. `caution` → `warning`.
 * - Paragraph unwrapping: Message lays the copy inside a real `<p>`, while
 *   markdown bodies arrive `<p>`-wrapped; nested `<p>` would be re-parented
 *   by the browser and break the box. Top-level paragraphs are unwrapped to
 *   inline prose (doc-callout's stated contract), with `<br><br>` keeping the
 *   break between multi-paragraph bodies.
 * - Titles: doc-callout dropped the title row by design. An authored
 *   `:::tip[Did you know?]` title is preserved as a lead-in to the copy
 *   ("Did you know? — ...") instead of being discarded.
 *
 * Known gap: bodies containing block content (lists, fenced code, tables)
 * violate doc-callout's inline-prose contract and re-parent outside the copy
 * span; those asides should move their blocks outside the callout.
 */
export interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger';
	title?: string;
}

const { type = 'note', title } = Astro.props as Props;

const kindMap = {
	note: 'note',
	tip: 'tip',
	caution: 'warning',
	danger: 'danger',
} as const;
const kind = kindMap[type] ?? 'note';

const escapeHtml = (value: string) =>
	value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

let body = (await Astro.slots.render('default')).trim();
body = body
	.replace(/<\/p>\s*<p>/g, '<br /><br />')
	.replace(/^<p>/, '')
	.replace(/<\/p>$/, '');

if (title) {
	body = `${escapeHtml(title)} — ${body}`;
}
---

<DocCallout kind={kind}>
	<Fragment set:html={body} />
</DocCallout>
