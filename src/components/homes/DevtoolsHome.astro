---
/*
  The Developer tools home, on the documentation home's anatomy: a hero with two ways in (a
  guided first deploy, or the setup prompt for a coding agent), then one directory whose
  groups and rows are the hub tree's, so it always matches the rail and the top nav.
*/
import Button from '@aziontech/webkit/button';
import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';
import HeroTitle from '@aziontech/webkit/hero-title';

import InlineLinks from '~/components/homes/InlineLinks.astro';
import SectionHeading from '~/components/homes/SectionHeading.astro';
import CopyPromptButton from '~/components/webkit/CopyPromptButton.vue';
import PromptPopover from '~/components/webkit/PromptPopover.vue';

import { devtoolsHome, homePrompt } from '~/data/devtools-home';
import { getHubDirectory, type Lang } from '~/nav/index';
import { getLanguageFromURL } from '~/util';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const { hero, promptPreview, tools } = devtoolsHome[lang];
const prompt = homePrompt(lang);
const groups = await getHubDirectory('devtools', lang);

const cols = (count: number) => (count >= 4 ? 4 : count >= 3 ? 3 : 2);
---

<div data-doc-chrome class="mb-(--spacing-12) sm:mb-(--spacing-16)">
	<HeroTitle title={hero.title} description={hero.description} />
	{
		/* The documentation home's action row, not HeroTitle's: its slot stretches each control
		   below `sm`, and a stretched highlight button reads as a second primary. Here all three
		   keep their natural size and the row wraps. */
	}
	<div class="mt-(--spacing-xl) flex flex-wrap items-center gap-(--spacing-sm)">
		<Button label={hero.buttonLabel} href={hero.buttonLink} kind="primary" size="large" />
		<CopyPromptButton
			client:visible
			prompt={prompt.prompt}
			label={prompt.label}
			copiedLabel={prompt.copiedLabel}
			tooltip={prompt.tooltip}
		/>
		<PromptPopover
			client:visible
			prompt={prompt.prompt}
			label={promptPreview.label}
			hideLabel={promptPreview.hideLabel}
			title={promptPreview.title}
			copyLabel={promptPreview.copyLabel}
			copiedLabel={promptPreview.copiedLabel}
		/>
	</div>
	<p
		class="m-0 mt-(--spacing-lg) max-w-(--container-2xl) text-pretty text-body-sm text-(--text-muted)"
	>
		{prompt.note}
	</p>
</div>

<SectionHeading id={tools.heading.slug} text={tools.heading.text} />
<p>{tools.intro}</p>
{
	/* Each tier title sits right before its grid: the prose contract pulls a block that follows an
	   h3 to the small step, which is the section-title gap. It carries the same anchor as the
	   section heading, so a group can be linked to. */
	groups.map((group) => (
		<>
			<SectionHeading
				depth={3}
				id={group.slug}
				text={group.label}
				data-doc-chrome
				class="m-0 mt-(--spacing-xl) px-(--spacing-xs) text-heading-xxs text-(--text-default)"
			/>
			<DocCardGroup cols={cols(group.items.length)}>
				{group.items.map((tool) => (
					<DocCard
						icon={tools.cards[tool.id]?.icon ?? ''}
						title={tool.label}
						href={tool.href}
						link={tools.cards[tool.id]?.link ?? ''}
					>
						{tool.description}
					</DocCard>
				))}
			</DocCardGroup>
		</>
	))
}
<InlineLinks prefix={tools.footer.prefix} links={tools.footer.links} />
