---
import Button from '@aziontech/webkit/button';
import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';
import FrameBox from '@aziontech/webkit/frame-box';

import CopyPromptButton from '~/components/webkit/CopyPromptButton.vue';
import HeroHome from '~/components/webkit/HeroHome.vue';
import InlineLinks from '~/components/homes/InlineLinks.astro';
import SectionHeading from '~/components/homes/SectionHeading.astro';

import type { DocsHomeContent } from '~/data/docs-home';

interface Props {
	content: DocsHomeContent;
}

const { content } = Astro.props;
const { hero, interfaceSection, sections } = content;
---

<HeroHome
	client:visible
	title={hero.title}
	description={hero.description}
	buttons={[{ label: hero.buttonLabel, link: hero.buttonLink }]}
	note={hero.note}
	prompt={hero.prompt}
	promptLabel={hero.promptLabel}
	promptCopiedLabel={hero.promptCopiedLabel}
	promptTooltip={hero.promptTooltip}
/>

<SectionHeading id={interfaceSection.heading.slug} text={interfaceSection.heading.text} />
<p>{interfaceSection.intro}</p>

<FrameBox data-doc-block data-doc-chrome>
	<div class="grid gap-px bg-(--border-default) lg:grid-cols-[7fr_3fr]">
		<FrameBox borders="none" marks="none" class="bg-(--bg-canvas)">
			<div class="flex h-full flex-col items-start gap-(--spacing-md) p-(--spacing-xl)">
				<h3 id={interfaceSection.agent.id} class="text-heading-lg text-(--text-default)">
					{interfaceSection.agent.title}
				</h3>
				<p class="m-0 text-body-md text-(--text-muted)">{interfaceSection.agent.body}</p>
				<CopyPromptButton
					client:visible
					class="mt-auto"
					label={interfaceSection.agent.copyLabel}
					copiedLabel={interfaceSection.agent.copiedLabel}
					tooltip={interfaceSection.agent.tooltip}
					prompt={interfaceSection.agent.prompt}
				/>
			</div>
		</FrameBox>
		<FrameBox borders="none" marks="none" class="bg-(--bg-canvas)">
			<div class="flex h-full flex-col items-start justify-between gap-(--spacing-lg) p-(--spacing-xl)">
				<p class="m-0 text-heading-md text-(--text-default)">{interfaceSection.guided.title}</p>
				<Button
					label={interfaceSection.guided.buttonLabel}
					kind="primary"
					size="large"
					href={interfaceSection.guided.buttonHref}
				/>
			</div>
		</FrameBox>
	</div>
</FrameBox>

<DocCardGroup cols={interfaceSection.cols}>
	{
		interfaceSection.cards.map((card) => (
			<DocCard icon={card.icon} title={card.title} href={card.href} link={card.link} class={card.class}>
				{card.body}
			</DocCard>
		))
	}
</DocCardGroup>

{
	sections.map((section) => (
		<>
			<SectionHeading id={section.heading.slug} text={section.heading.text} />
			<p>{section.intro}</p>

			<DocCardGroup cols={section.cols} mobileCols={section.mobileCols}>
				{section.cards.map((card) => (
					<DocCard
						icon={card.icon}
						title={card.title}
						href={card.href}
						link={card.link}
						target={card.target}
						class={card.class}
					>
						{card.body}
					</DocCard>
				))}
			</DocCardGroup>

			{section.footer && <InlineLinks prefix={section.footer.prefix} links={section.footer.links} />}
		</>
	))
}
