---
/**
 * The "Also useful: A, B" line that closes most sections. Everything renders on
 * one source line on purpose: Astro keeps the whitespace between expressions, so
 * breaking this up would pad the markup the MDX version emitted tightly.
 */
import type { DocLink } from '~/data/docs-home';

interface Props {
	prefix: string;
	links: DocLink[];
}

const { prefix, links } = Astro.props;
---

<p>
	{prefix}
	{
		links.map((link, index) => (
			<>
				{index > 0 ? ', ' : ''}
				<a href={link.href}>{link.label}</a>
			</>
		))
	}
</p>
