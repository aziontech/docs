---
/**
 * The `rehype-autolink-headings` pass only runs on markdown and MDX, so an
 * Astro page has to write the anchor itself. Markup here is kept byte-identical
 * to `plugins/rehype-autolink-config.ts` so headings that moved out of MDX
 * still match the styling and the anchor behaviour of the ones that stayed.
 */
interface Props {
	id: string;
	text: string;
}

const { id, text } = Astro.props;
---

<h2 id={id}>{text}<a data-doc-anchor href={`#${id}`}><i class="ml-2 pi pi-link" data-icon></i></a></h2>
