---
/**
 * The `rehype-autolink-headings` pass only runs on markdown and MDX, so an
 * Astro page has to write the anchor itself. The classes come from the same
 * module that pass uses, so headings that moved out of MDX keep the styling
 * and the anchor behaviour of the ones that stayed.
 */
import {
	anchorClass,
	headingClass,
	iconClass,
	textClass
} from '../../../plugins/rehype-autolink-config';

interface Props {
	id: string;
	text: string;
}

const { id, text } = Astro.props;
---

<h2 id={id} data-doc-heading="2" class={headingClass}>
	<a data-doc-anchor href={`#${id}`} class={anchorClass}>
		<span class={textClass}>{text}</span>
		<i class={iconClass} aria-hidden="true"></i>
	</a>
</h2>
