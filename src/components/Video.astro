---
/**
 * Single source of truth for embedded videos in the docs.
 *
 * From one authoring point (`<Video src="…" title="…" />`) it renders BOTH:
 * 1. a responsive YouTube `<iframe>` embed, and
 * 2. an inline `<script type="application/ld+json">` with a schema.org
 *    `VideoObject` (so Google can index the video and show rich results).
 *
 * Emitting the JSON-LD inline next to the embed is valid for Google — it does
 * not need to live in `<head>` or in an `@graph`.
 *
 * Stays hand-built, and not for lack of a design-system component: webkit's
 * DocFrame is exactly this surface (a framed figure with an optional caption)
 * and it cannot be server-rendered today. Its setup calls
 * `useEventListener(document, 'keydown', …)`, so `document` is dereferenced
 * while the component is setting up, which on the server is a
 * `ReferenceError`. Vue's error handler swallows it and renders the template
 * anyway with every `<script setup>` binding empty: the frame comes out with
 * no `data-testid` of its own and an empty slot — the framed content silently
 * disappears. Astro's build still exits 0. Verified in the built HTML with
 * the content passed both as children and as `<Fragment slot="default">`;
 * props are unaffected (a `caption` renders), which is what pins the fault to
 * setup rather than to the slot handoff.
 *
 * Two other things would need answers even once that is fixed: DocFrame
 * branches between `<img>` and `<video>` by file extension, and a YouTube
 * player is neither; and it has no notion of an aspect ratio, so the 16/9 box
 * below would stay local regardless.
 */
import { SITE_URL } from '~/consts';
import { getVideoObjectSchema, getYouTubeId } from '~/util/videoObject';

export interface Props {
	/** YouTube embed URL, e.g. `https://www.youtube.com/embed/KB4f4bSyHgI`. */
	src: string;
	/** Video title (required — used as the accessible iframe title and schema `name`). */
	title: string;
	/** Optional video description for the structured data. */
	description?: string;
	/** Overrides the thumbnail derived from the YouTube ID. */
	thumbnailUrl?: string;
	/** ISO 8601 date used as `uploadDate` (e.g. `2023-07-03`). */
	uploadDate?: string;
	/** ISO 8601 duration (e.g. `PT1M30S`). Optional. */
	duration?: string;
}

const { src, title, description, thumbnailUrl, uploadDate, duration } = Astro.props;

// Stable, page-scoped @id so the node is unambiguous and unique per video.
const youtubeId = getYouTubeId(src);
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const id = `${canonical}#video${youtubeId ? `-${youtubeId}` : ''}`;

const schema = getVideoObjectSchema({
	src,
	title,
	description,
	thumbnailUrl,
	uploadDate,
	duration,
	id,
});
---

<div class="video-embed">
	<iframe
		src={src}
		title={title}
		loading="lazy"
		frameborder="0"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		referrerpolicy="strict-origin-when-cross-origin"
		allowfullscreen></iframe>
</div>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
	.video-embed {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
	}

	.video-embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 0.5rem;
	}
</style>
