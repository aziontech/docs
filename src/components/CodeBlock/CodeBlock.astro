---
import WebkitCodeBlock from '~/components/webkit/CodeBlock.vue';

interface Props {
	code: string;
	lang?: string;
	fileName?: string;
	showLineNumbers?: boolean;
}

const { code, lang, fileName, showLineNumbers } = Astro.props as Props;
---

<WebkitCodeBlock
	client:visible
	code={code}
	lang={lang}
	fileName={fileName}
	showLineNumbers={showLineNumbers}
/>
