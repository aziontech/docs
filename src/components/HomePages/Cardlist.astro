---
interface Props {
	data: Array<{
		title: string,
		cards: Array<{
			icon: string,
			title: string,
			description: string,
			link: string
		}>
	}>;
}

/*
	DocCardGroup is both the frame and the rules: the cards abut inside it and the
	hairlines between them are the grid's own gaps, so the group -- not each card --
	carries the border. That is why nothing below draws a grid or a gap of its own.
	`cols={2}` is the two-up the hand-built grid had, and the group collapses to a
	single column on a phone.
*/

import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';

const { data } = Astro.props;
---
<div class="mt-8">
{
	data.map((item) =>(
		<h2>
			{item.title}
		</h2>
		<div class="my-8">
			<DocCardGroup cols={2}>
				{
					item.cards.map((card) => (
						<DocCard
							title={card.title}
							label={card.description}
							href={card.link}
						/>
					))
				}
			</DocCardGroup>
		</div>
	))
}
</div>
