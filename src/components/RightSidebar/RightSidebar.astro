---
/**
 * The reading page's right rail — the outline, then the complementary groups, then
 * the offer at the FOOT of the column. The order is the reference's: the rail serves
 * the page before it asks for anything, so the one commercial block on the screen is
 * both last and the furthest thing from the reader's eye when they arrive.
 */
import { useTranslations } from '~/i18n/util';
import { getLanguageFromURL } from '~/util';

import ScrollArea from '@aziontech/webkit/scroll-area';

import DocCta from '~/components/RightSidebar/DocCta.astro';
import OnThisPage from '~/components/webkit/OnThisPage.vue';

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname) || 'en';

const { headings, githubEditUrl } = Astro.props;

const groups = [
	{
		label: 'GitHub',
		links: [
			{
				label: 'Azion Docs',
				href: 'https://github.com/aziontech/docs/blob/main/README.md',
				icon: 'pi pi-github',
				tracking: 'github_link'
			},
			{
				label: t('rightSidebar.editPage'),
				href: githubEditUrl,
				icon: 'pi pi-pencil',
				tracking: 'contribute_link'
			}
		]
	},
	{
		label: t('rightSidebar.community'),
		links: [
			{
				label: t('rightSidebar.joinDiscord'),
				href: 'https://discord.com/invite/Yp9N7RMVZy',
				icon: 'pi pi-discord'
			},
			{
				label: t('rightSidebar.readBlog'),
				href: `https://www.azion.com/${lang}/blog/`,
				icon: 'pi pi-comment'
			},
			{
				label: t('rightSidebar.followTwitter'),
				href: 'https://twitter.com/aziontech',
				icon: 'ai ai-x'
			}
		]
	}
];
---

<!--
	The scrolling is the design system's, not an `overflow-y-auto` typed here: the
	thin, tokenised scrollbar the left rail already wears, so the two match. It opens
	on the column boundary (`pt-(--spacing-md)`) — the same step the page opens its own
	column on — and insets its links by `px-(--spacing-md)` off the border it sits behind.

	`tabindex="-1"`, unlike the reading column: this column is nothing but links, so
	tabbing through them already scrolls it and a stop on the container itself would be
	a stop that does nothing. No `nav` wrapper either — `DocOnThisPage` renders its own,
	named by its title, and a second landmark around it named only "Secondary" is a
	landmark that says less than the one inside it.
-->
<ScrollArea
	tabindex="-1"
	class="flex h-full flex-col px-(--spacing-md) pt-(--spacing-md) pb-(--spacing-lg)">
	<!--
		A column, not a block, so its content can address the FOOT of the rail and not
		just the end of the outline: this page's rail is short, so anything after it
		would otherwise float halfway up a mostly empty column. The wrapper claims the
		whole height (`flex-1`) so `mt-auto` has room to push against; the gap stays the
		floor between the two, for the case where a long outline fills it.
	-->
	<div class="flex flex-1 flex-col gap-(--spacing-xl)">
		<OnThisPage
			client:idle
			headings={headings ?? []}
			title={t('rightSidebar.onThisPage')}
			initialHeadingTitle={t('rightSidebar.overview')}
			groups={groups}
		/>

		<DocCta
			class="mt-auto"
			title={t('rightSidebar.ctaTitle')}
			description={t('rightSidebar.ctaDescription')}
			primaryLabel={t('rightSidebar.ctaPrimary')}
			primaryHref={t('rightSidebar.ctaPrimaryLink')}
			secondaryLabel={t('rightSidebar.ctaSecondary')}
			secondaryHref={t('rightSidebar.ctaSecondaryLink')}
		/>
	</div>
</ScrollArea>
