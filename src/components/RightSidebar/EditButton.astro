---
/**
 * Stays a hand-written link list, and the design system is the reason twice
 * over. webkit's Link renders its icon *after* the label with no position
 * prop, while both of these read icon-first (`pi pi-github`, `pi pi-pencil`);
 * and Link declares `inheritAttrs: false`, which drops the inline `onclick`
 * that reports the click to AzAnalytics. Wrapping each Link in a span that
 * catches the click by bubbling would restore the tracking, but not the icon
 * side, and it trades a plain anchor for two elements and an indirection.
 * Both gaps are filed against webkit; this list adopts Link the day it takes
 * an icon position and forwards attributes.
 */
export interface Props {
	editHref: string;
}
import UIString from '../UIString.astro';
const { editHref } = Astro.props;
---
<ul class="flex flex-col gap-2">
	<li>
		<a
			class="text-muted text-sm hover:underline"
			href="https://github.com/aziontech/docs/blob/main/README.md"
			target="_blank"
			data-tracking="github_docs"
			onclick="if(window.AzAnalytics?.trackClick) window.AzAnalytics.trackClick('right_sidebar', { href: this.href, text: 'Azion Docs', type: 'github_link' })"
		>
			<i class="pi pi-github mr-1"></i>
			Azion Docs
		</a>
	</li>
	<li>
		<a
			class="text-muted text-sm hover:underline"
			href={editHref} target="_blank"
			data-tracking="edit_page"
			onclick="if(window.AzAnalytics?.trackClick) window.AzAnalytics.trackClick('right_sidebar', { href: this.href, text: 'Edit Page', type: 'contribute_link' })"
		>
			<i class="pi pi-pencil mr-1"></i>
			<UIString key="rightSidebar.editPage" />
		</a>
	</li>
</ul>
