---
import { getLanguageFromURL } from '~/util';
import type { Lang } from '~/nav/index';
import AgentPicker from './AgentPicker.vue';
import { agentHrefs } from './server';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const hrefs = await agentHrefs(lang);
---
<AgentPicker
	client:load
	lang={lang}
	hrefs={hrefs}
/>
