---
import { getLanguageFromURL } from '~/util';
import { useTranslations } from '~/i18n/util';
import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { getBreadcrumb, getPageHref, type Lang } from '~/nav/index';
import AgentPageHeader from '~/components/agents/AgentPageHeader.vue';
import { agentBySlug, agentLinks } from './data';
import { agentPageUpdated, toolHrefs } from './server';

interface Props {
	agent: string;
}

const { agent } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const t = useTranslations(Astro);
const breadcrumb = (await getBreadcrumb(Astro.url.pathname, lang)).map(({ label, url }) => ({ label, href: url }));
const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
const entry = agentBySlug(agent);
const links = entry ? agentLinks(entry, lang, await toolHrefs(lang)) : [];
const agentSetupHref = await getPageHref('documentation_agent_setup', lang);
// Kept on purpose: the reference omits the date on agent pages, ours shows it (Marcus, Sep 9).
const lastUpdated = await agentPageUpdated(Astro.url.pathname, lang);
const headerLabels = {
	lastUpdated: t('pageHeader.lastUpdated'),
	copy: t('pageHeader.copy'),
	copied: t('pageHeader.copied'),
	copyTip: t('pageHeader.copyTip'),
	view: t('pageHeader.view'),
	viewTip: t('pageHeader.viewTip'),
	agents: t('pageHeader.agents'),
	agentsTip: t('pageHeader.agentsTip'),
};
---
<AgentPageHeader
	client:load
	agent={agent}
	lang={lang}
	breadcrumb={breadcrumb}
	markdownHref={markdownHref}
	locale={normalizeLangTag(lang)}
	labels={headerLabels}
	lastUpdated={lastUpdated}
	agentSetupHref={agentSetupHref}
	links={links}
/>
