---
import { getLanguageFromURL } from '~/util';
import { useTranslations } from '~/i18n/util';
import { getGuidesHome, type Lang } from '~/nav/index';
import GuidesHome from '~/components/webkit/GuidesHome.vue';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const t = useTranslations(Astro);
const { featured, areas, products } = await getGuidesHome('guides', lang);

const labels = {
	featured: t('guides.featured'),
	filter: t('guides.filter'),
	allProducts: t('guides.allProducts'),
	empty: t('guides.empty'),
	count: t('guides.count'),
};
---
<GuidesHome
	client:load
	featured={featured}
	areas={areas}
	products={products}
	labels={labels}
/>
