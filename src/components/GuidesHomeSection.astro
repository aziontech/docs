---
/** The guides DIRECTORY: a masthead band, then the catalog band. */
// The masthead is the docs home's, rung for rung — the two hubs are the same kind of page.
// The reading chrome a doc page carries (breadcrumb, last-updated, Copy as Markdown, Agent
// setup) is deliberately absent: none of it describes a catalog.
import { getLanguageFromURL } from '~/util';
import { useTranslations } from '~/i18n/util';
import type { Lang } from '~/nav/index';
import { guidesCatalog, guidesCatalogHref } from '~/util/guidesCatalog';
import GuidesHome, { PAGE_SIZE } from '~/components/webkit/GuidesHome.vue';

interface Props {
	/** The page's own heading; falls back to the catalogue's name. */
	title: string;
}

const { title } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const t = useTranslations(Astro);
const { rows, kinds, products } = await guidesCatalog(lang);

const totals = { kinds: {} as Record<string, number>, products: {} as Record<string, number> };
for (const row of rows) {
	totals.kinds[row.kind] = (totals.kinds[row.kind] ?? 0) + 1;
	for (const product of row.products)
		totals.products[product] = (totals.products[product] ?? 0) + 1;
}

const labels = {
	search: t('guides.search'),
	filters: t('guides.filters'),
	contentType: t('guides.contentType'),
	topics: t('guides.topics'),
	kinds: {
		'learning-path': t('guides.kind.learningPath'),
		tutorial: t('guides.kind.tutorial'),
		'reference-architecture': t('guides.kind.referenceArchitecture'),
		video: t('guides.kind.video'),
	},
	countOne: t('guides.count.one'),
	countMany: t('guides.count.many'),
	clear: t('guides.clear'),
	empty: t('guides.empty'),
	emptyHint: t('guides.emptyHint'),
	error: t('guides.error'),
	retry: t('guides.retry'),
	loading: t('guides.loading'),
	pagination: t('guides.pagination'),
	previous: t('guides.previous'),
	next: t('guides.next'),
	range: t('guides.range'),
};
---

{
	/*
	  The lede comes from the page's own MDX so the sentence — and the link inside it —
	  stays in the file a translator edits. `[&_p]:m-0` is what lets it arrive as a
	  paragraph without opening a second margin under the one this header already sets.
	*/
}
<header class="mb-(--spacing-xxl) sm:mb-16">
	<h1 class="m-0 max-w-(--container-2xl) text-balance text-heading-2xl text-(--text-default)">
		{title}
	</h1>
	<div
		class="mt-(--spacing-lg) max-w-(--container-xl) text-pretty text-body-lg leading-relaxed text-(--text-muted) [&_a:hover]:text-(--text-link-hover) [&_a]:text-(--text-link-color) [&_a]:underline [&_a]:underline-offset-2 [&_p]:m-0"
	>
		<slot />
	</div>
</header>

<GuidesHome
	client:load
	initial={rows.slice(0, PAGE_SIZE)}
	total={rows.length}
	totals={totals}
	catalogHref={guidesCatalogHref(lang)}
	kinds={kinds}
	products={products}
	labels={labels}
/>
