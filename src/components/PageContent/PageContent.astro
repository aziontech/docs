---
import FallbackNotice from '../FallbackNotice.astro';

import DocPageHeader from '~/components/webkit/DocPageHeader.vue';
import ReadableContent from '~/components/webkit/ReadableContent.vue';
import DocPagination from '@aziontech/webkit/doc-pagination';

import { rtlLanguages } from '~/i18n/languages';
import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { useTranslations } from '~/i18n/util';

import { getLanguageFromURL } from '~/util';
import { getBreadcrumb, getPageFacts, getPageHref, getTreeId, type Lang } from '~/nav/index';


export interface Props {
	content: { title: string; description?: string; page_header?: boolean };
	previous?: { text: string; link: string };
	next?: { text: string; link: string };
}

const {content, previous, next} = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname);
const isFallback = !!Astro.params.fallback || undefined;

const title = content.title
const bcpLang = normalizeLangTag(lang);
const direction = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
const crumbs = (await getBreadcrumb(Astro.url.pathname, lang as Lang)).map(({ label, url }) => ({ label, href: url }));
const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
const lastUpdated = (await getPageFacts(Astro.url.pathname, lang as Lang))?.updated?.slice(0, 10);
const agentSetupHref =
	(await getTreeId(Astro.url.pathname, lang as Lang)) === 'agent-setup'
		? undefined
		: await getPageHref('documentation_agent_setup', lang as Lang);
const t = useTranslations(Astro);
const headerLabels = {
	lastUpdated: t('pageHeader.lastUpdated'),
	copy: t('pageHeader.copy'),
	copied: t('pageHeader.copied'),
	copyTip: t('pageHeader.copyTip'),
	view: t('pageHeader.view'),
	viewTip: t('pageHeader.viewTip'),
	agents: t('pageHeader.agents'),
	agentsTip: t('pageHeader.agentsTip'),
};
---


<div dir={isFallback ? 'ltr' : direction} lang={isFallback && 'en'}>
	<!-- {
		// For best cross-browser support of sticky or fixed elements, they must not be nested
		// inside elements that hide any overflow axis. The article hides `overflow-x`,
		// so we must place fixed UI elements like the mobile TOC here.
		Astro.slots.has('before-article') && (
			<>
				<div class="fixed-mobile-bar" dir={direction}>
					<slot name="before-article" />
				</div>
				<div class="spacer" />
			</>
		)
	} -->
	<article class="pt-(--spacing-md)">
		{
			/*
			 * THE MASTHEAD IS A BANNER, THE PROSE IS A COLUMN. The header is NOT in
			 * `px-container` — it spans the content column edge to edge, so the rule it
			 * closes on reads as the page's own horizon instead of a line under the
			 * title. Its words still land on the container's measure, because
			 * `doc-page-banner` pads it by exactly what `px-container` would have
			 * (see the style below), so nothing has to fight the component's own border.
			 */
			content.page_header !== false && (
				<DocPageHeader
					class="doc-page-banner mb-8"
					title={title}
					breadcrumb={crumbs}
					description={content.description}
					markdownHref={markdownHref}
					locale={bcpLang}
					labels={headerLabels}
					lastUpdated={lastUpdated}
					agentSetupHref={agentSetupHref}
					client:load
				/>
			)
		}
		<section class="px-container">
			<ReadableContent client:load>
				{
					isFallback && (
						<div lang={bcpLang} dir={direction}>
							<FallbackNotice />
						</div>
					)
				}
			
				<slot />
			</ReadableContent>
		</section>

		{
			/*
			 * The pair carries its own column and its own close: `px-container` is the
			 * measure the prose above it takes, and `pt-12` is the 48 that closes a
			 * section in the prose contract. It used to sit in an `aside` — a second
			 * landmark around a `nav` that already has one — under an `hr` that spent
			 * another 48 saying the same thing.
			 */
			(previous || next) && (
				<DocPagination
					previous={previous && { title: previous.text, href: previous.link }}
					next={next && { title: next.text, href: next.link }}
					previousLabel={t('articleNav.prevPage')}
					nextLabel={t('articleNav.nextPage')}
					class="px-container pt-12"
				/>
			)
		}
	</article>
</div>

<style is:global>
	/*
	 * THE BANNER IS FULL BLEED, ITS CONTENT IS CONTAINED. The masthead keeps the
	 * whole column's width — its `border-b` is the page's horizon and has to reach
	 * both edges — so the alignment is paid for in padding rather than by wrapping
	 * it in `px-container`, which would pull the rule in with the words.
	 *
	 * The padding is `px-container`'s own math: the centering margin a 4xl column
	 * would have taken, `(100% - 4xl) / 2`, and never negative — `min(100%, …)`
	 * folds it to zero while the column is narrower than the measure — plus that
	 * utility's gutter at the same breakpoint. Change one and change the other, or
	 * the title stops sitting over the first paragraph.
	 *
	 * Unlayered on purpose: a plain declaration outranks Tailwind's layered
	 * utilities, so this needs no `!important` — and, because Tailwind is imported
	 * in `important` mode here, an `!important` override would have lost anyway.
	 */
	.doc-page-banner {
		padding-inline: calc((100% - min(100%, var(--container-4xl))) / 2 + 1rem);
	}

	@media (min-width: 768px) {
		.doc-page-banner {
			padding-inline: calc((100% - min(100%, var(--container-4xl))) / 2 + 2rem);
		}
	}
</style>
