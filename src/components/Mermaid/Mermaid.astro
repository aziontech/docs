---
/**
 * Renders a ```mermaid fence as a diagram. The remark plugin in
 * `integrations/astro-code-blocks.ts` swaps the fence for this component;
 * the client-only renderer lives in `MermaidDiagram.vue` so the mermaid
 * bundle loads lazily and only when the diagram scrolls into view. The
 * `<noscript>` keeps the diagram source in the static HTML for readers and
 * crawlers without JS; it sits outside the island so hydration never sees it.
 */
import CodeBlock from '~/components/webkit/CodeBlock.vue';
import MermaidDiagram from '~/components/webkit/MermaidDiagram.vue';

interface Props {
	code: string;
	title?: string;
}

const { code, title } = Astro.props as Props;
---

<MermaidDiagram client:visible code={code} title={title} />
<noscript><CodeBlock code={code} lang="mermaid" /></noscript>
