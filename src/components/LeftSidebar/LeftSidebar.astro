---
export interface Props {
	currentPage: string;
	menuType: string;
};

import { removeLeadingSlash,  getLanguageFromURL} from '~/util';
import { getNavigationMenu } from '~/util/getNav';
import { useTranslations } from '~/i18n/util';
import SidebarPanelMenu from '~/components/sidebarpanelmenu/SidebarPanelMenu.vue';

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname);
const { currentPage, menuType = 'nav' } = Astro.props as Props;
const currentPageMatch = removeLeadingSlash(currentPage);

const sidebarSections = (await getNavigationMenu(Astro, menuType)).reduce((collection, item) => {
	collection.push({...item});
	return collection;
}, []);

function recursiveTranslation(menuList) {
	menuList.map(menu => {
		if(menu.hasLabel) {
			menu.hasLabel = t(menu.hasLabel);
		}
		
		if(menu.items) recursiveTranslation(menu.items);
	});
};
---
<div class="wrap-nav">
	<nav aria-label={t('leftSidebar.a11yTitle')} class="px-4">
		<SidebarPanelMenu
			client:idle 
			lang={lang}
			filterMobile={true}
			data={sidebarSections.map((item) => {
				if(item.hasLabel) item.hasLabel = t(item.hasLabel);
				if(item.items) recursiveTranslation(item.items); 
				
				return item;
			})}
			currentPageMatch={currentPageMatch} />
	</nav>
</div>

<script is:inline>
/**
 * Preserve sidebar scroll across page loads
 */
{
	// .wrap-nav is the scroll container (overflow: auto) — not the inner nav
	const wrapNav = document.querySelector('#left-sidebar .wrap-nav');
	if (wrapNav) {
		// PrimeVue PanelMenu server-renders nested submenus hidden (activeItemPath is
		// only seeded client-side in mounted()), so the active chain pops open late at
		// hydration. Un-hide its ancestors now so first paint matches the final state.
		wrapNav.querySelectorAll('a.surface-200').forEach((active) => {
			for (let el = active.parentElement; el && el !== wrapNav; el = el.parentElement) {
				if (el.dataset.pcSection === 'toggleablecontent') el.style.display = '';
			}
		});

		const leftSidebarScroll = localStorage.getItem('sidebar-scroll');

		if (leftSidebarScroll !== null) {
			wrapNav.scrollTop = parseInt(leftSidebarScroll, 10);
		}

		// If the active row still isn't visible (direct link, stale position),
		// scroll the container — not the window — until it is.
		const active = wrapNav.querySelector('a.surface-200');
		if (active) {
			const wrapRect = wrapNav.getBoundingClientRect();
			const activeRect = active.getBoundingClientRect();
			if (activeRect.top < wrapRect.top || activeRect.bottom > wrapRect.bottom) {
				wrapNav.scrollTop += activeRect.top - wrapRect.top - wrapRect.height / 3;
			}
		}

		window.addEventListener('beforeunload', () => {
			localStorage.setItem('sidebar-scroll', wrapNav.scrollTop);
		});
	}
}
</script>
