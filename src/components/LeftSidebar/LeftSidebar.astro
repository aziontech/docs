---
import { useTranslations } from '~/i18n/util';
import type { SidebarModel } from '~/nav/index';
import DocsSidebar from '~/components/webkit/DocsSidebar.vue';

export interface Props {
	sidebar: SidebarModel;
}

const t = useTranslations(Astro);
const { groups, activeId, expandedIds, path, backLabel } = Astro.props.sidebar;
---
<!-- `client:load`, not `idle`: a drilled level only exists once the menu hydrates (webkit teleports
     it into the mounted menu), so a product page shows an empty rail until then. -->
<DocsSidebar
	client:load
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	initialPath={path}
	backLabel={backLabel ?? ''}
	ariaLabel={t('leftSidebar.a11yTitle')}
	filterPlaceholder={t('leftSidebar.filter')}
	noMatchesLabel={t('leftSidebar.noMatches')}
/>
