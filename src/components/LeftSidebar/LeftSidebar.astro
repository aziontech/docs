---
export interface Props {
	currentPage: string;
	menuType: string;
};

import { removeLeadingSlash, getLanguageFromURL } from '~/util';
import { getNavigationMenu } from '~/util/getNav';
import { useTranslations } from '~/i18n/util';
import { buildSidebarMenu } from '~/util/menuToWebkit';
import DocsSidebar from '~/components/webkit/DocsSidebar.vue';

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname);
const { currentPage, menuType = 'nav' } = Astro.props as Props;
const currentPageMatch = removeLeadingSlash(currentPage);

const { groups, activeId, expandedIds } = buildSidebarMenu(
	await getNavigationMenu(Astro, menuType),
	{
		lang,
		currentPageMatch,
		filterMobile: true,
		translateLabel: t,
	}
);
---
<DocsSidebar
	client:idle
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	ariaLabel={t('leftSidebar.a11yTitle')}
/>
