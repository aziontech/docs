---
export interface Props {
	currentPage: string;
};

import { getLanguageFromURL } from '~/util';
import { useTranslations } from '~/i18n/util';
import { getSidebar, type Lang } from '~/nav/index';
import DocsSidebar from '~/components/webkit/DocsSidebar.vue';

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const { currentPage } = Astro.props as Props;

const { groups, activeId, expandedIds } = await getSidebar(currentPage, lang);
---
<DocsSidebar
	client:idle
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	ariaLabel={t('leftSidebar.a11yTitle')}
/>
