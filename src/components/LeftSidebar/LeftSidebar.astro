---
import DocsSidebar from '~/components/webkit/DocsSidebar.vue';
import { useTranslations } from '~/i18n/util';
import { getLanguageFromURL } from '~/util';
import type { SidebarModel } from '~/nav/index';

export interface Props {
	sidebar: SidebarModel;
}

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname);
const { groups, activeId, expandedIds, header, catalog } = Astro.props.sidebar;
---

<DocsSidebar
	client:idle
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	header={header}
	catalogGroups={catalog}
	treesHref={`/${lang}/sidebar-trees.json`}
	backLabel={t('leftSidebar.backToDocs')}
	backToPattern={t('leftSidebar.backTo')}
	ariaLabel={t('leftSidebar.a11yTitle')}
	filterPlaceholder={t('leftSidebar.filter')}
	noMatchesLabel={t('leftSidebar.noMatches')}
/>
