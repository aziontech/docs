# Lint the staged files with the webkit rules before every commit.
# Whole-tree lint would trip on known debt and local artifacts; the CI gate
# ratchets on changed files, and this hook mirrors it: what you touch, you
# leave clean.
staged() { git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true; }

code=$(staged '\.(js|mjs|cjs|ts|tsx|vue|astro)$')
if [ -n "$code" ]; then
	printf '%s\n' "$code" | tr '\n' '\0' | xargs -0 npx eslint --max-warnings 0
fi

style=$(staged '\.(css|scss|vue|astro)$')
if [ -n "$style" ]; then
	printf '%s\n' "$style" | tr '\n' '\0' | xargs -0 npx stylelint
fi
