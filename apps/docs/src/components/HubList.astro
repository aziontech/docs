---
import DocItem from '@aziontech/webkit/doc-item';
import FrameBox from '@aziontech/webkit/frame-box';
import ItemList from '@aziontech/webkit/item-list';

import { getHubList, type Lang } from '~/nav/index';
import { getLanguageFromURL } from '~/util';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const items = await getHubList(Astro.url.pathname, lang);
---

{items && items.length > 0 && (
	<FrameBox data-doc-block>
		<ItemList>
			{items.map((item) => (
				<DocItem title={item.label} href={item.href} target={item.target}>
					{item.description}
				</DocItem>
			))}
		</ItemList>
	</FrameBox>
)}
