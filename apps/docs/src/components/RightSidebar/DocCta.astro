---
/**
 * The rail's closing offer — the one commercial block on a reading page, parked at
 * the foot of "On this page". A port of the design system's own `DocCta`
 * (@aziontech/webkit-docs), which this project does not install: the block is
 * `FrameBox` + `Brand` + `Button`, so it is composed here from the same webkit
 * parts rather than approximated.
 */
// Static on purpose: two links and a wordmark need no island, and the rail already
// hydrates one for the outline.
import Brand from '@aziontech/webkit/brand';
import Button from '@aziontech/webkit/button';
import FrameBox from '@aziontech/webkit/frame-box';

export interface Props {
	/** The offer's headline. */
	title: string;
	/** The offer's copy, under the headline. */
	description?: string;
	/** The primary action's label. */
	primaryLabel: string;
	/** Where the primary action goes. */
	primaryHref: string;
	/** The secondary action's label; empty renders no secondary action. */
	secondaryLabel?: string;
	/** Where the secondary action goes. */
	secondaryHref?: string;
	/** Utilities for the block's own frame — the rail passes its `mt-auto`. */
	class?: string;
}

const {
	title,
	description,
	primaryLabel,
	primaryHref,
	secondaryLabel,
	secondaryHref,
	class: className,
} = Astro.props;

// One CTA per page, so the landmark's name can be a literal id: `aria-labelledby`
// rather than `aria-label` keeps the name and the visible headline from drifting.
const titleId = 'doc-cta-title';
---

<FrameBox
	data-testid="doc-cta"
	role="complementary"
	aria-labelledby={titleId}
	class:list={['w-full', className]}
>
	<!-- One step up the surface palette from the rail's canvas, and opaque, so the
	     block reads as its own object in a column of bare links. -->
	<div class="flex flex-col bg-(--bg-surface) px-6 py-5">
		<!-- The mark opens the block where a `DocCard` opens with its glyph, at `Brand`'s
		     smallest lockup. The reference trims it 2px further with an `!important` on the
		     component's own svg; this project does not reach inside a webkit component. -->
		<Brand kind="default" size="small" class="mb-(--spacing-md)" />

		<p id={titleId} class="m-0 text-heading-xxs text-(--text-default)">{title}</p>

		{
			description && (
				<p class="m-0 mt-(--spacing-xxs) text-body-xs text-(--text-muted)">{description}</p>
			)
		}

		<!-- Stacked, not side by side: the rail is ~225px, and two buttons across it
		     would each be too narrow to hold a label without wrapping. -->
		<div class="mt-(--spacing-md) flex flex-col gap-(--spacing-xs)">
			<Button label={primaryLabel} href={primaryHref} size="medium" class="w-full" />
			{
				secondaryLabel && (
					<Button
						label={secondaryLabel}
						href={secondaryHref}
						kind="outlined"
						size="medium"
						class="w-full"
					/>
				)
			}
		</div>
	</div>
</FrameBox>
