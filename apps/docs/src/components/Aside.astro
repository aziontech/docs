---
import DocCallout from '@aziontech/webkit/doc-callout';

export interface Props {
	type?: 'note' | 'tip' | 'caution' | 'danger';
	title?: string;
}

const { type = 'note', title } = Astro.props as Props;

const kindMap = {
	note: 'note',
	tip: 'tip',
	caution: 'warning',
	danger: 'danger',
} as const;
const kind = kindMap[type] ?? 'note';

const escapeHtml = (value: string) =>
	value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// The paragraphs and lists pass through as rendered: DocCallout lays out their rhythm.
let body = (await Astro.slots.render('default')).trim();

if (title) {
	const lead = escapeHtml(title);
	body = body.startsWith('<p>') ? `<p>${lead} — ${body.slice(3)}` : `<p>${lead}</p>${body}`;
}
---

<DocCallout kind={kind}>
	<Fragment set:html={body} />
</DocCallout>
