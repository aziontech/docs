---
import WebkitCodeBlock from '~/components/webkit/CodeBlock.vue';

interface Props {
	code: string;
	lang?: string;
	fileName?: string;
	showLineNumbers?: boolean;
	diff?: boolean | string;
}

const { code, lang, fileName, showLineNumbers, diff } = Astro.props as Props;
const locale = Astro.url.pathname.startsWith('/pt-br/') ? 'pt-br' : 'en';
---

<WebkitCodeBlock
	client:visible
	code={code}
	lang={lang}
	fileName={fileName}
	showLineNumbers={showLineNumbers}
	diff={diff === true || diff === 'true'}
	locale={locale}
/>
