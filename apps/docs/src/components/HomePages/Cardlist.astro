---
interface Props {
	data: Array<{
		title: string;
		cards: Array<{
			icon: string;
			title: string;
			description: string;
			link: string;
		}>;
	}>;
}

import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';

const { data } = Astro.props;
---

<div class="mt-8">
	{
		data.map((item) => (
			<>
				<h2>{item.title}</h2>
				<div class="my-8">
					<DocCardGroup cols={2}>
						{item.cards.map((card) => (
							<DocCard title={card.title} label={card.description} href={card.link} />
						))}
					</DocCardGroup>
				</div>
			</>
		))
	}
</div>
