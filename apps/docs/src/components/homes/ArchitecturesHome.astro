---
/*
  The Architectures home, on the Developer tools home's anatomy: a hero with no action,
  then one directory whose groups and rows are the architectures tree's,
  so it always matches the rail. Each group is a Solution; each card is one architecture.
*/
import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';
import HeroTitle from '@aziontech/webkit/hero-title';

import InlineLinks from '~/components/homes/InlineLinks.astro';
import SectionHeading from '~/components/homes/SectionHeading.astro';

import { architecturesHome } from '~/data/architectures-home';
import { getHubDirectory, type Lang } from '~/nav/index';
import { getLanguageFromURL } from '~/util';

const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const { hero, directory } = architecturesHome[lang];
const groups = await getHubDirectory('architectures', lang);

const cols = (count: number) => (count >= 4 ? 4 : count >= 3 ? 3 : 2);
---

<div data-doc-chrome class="mb-(--spacing-12) sm:mb-(--spacing-16)">
	<HeroTitle title={hero.title} description={hero.description} />
</div>

<SectionHeading id={directory.heading.slug} text={directory.heading.text} />
<p>{directory.intro}</p>
{
	groups.map((group) => (
		<>
			<SectionHeading
				depth={3}
				id={group.slug}
				text={group.label}
				data-doc-chrome
				class="m-0 mt-(--spacing-xl) px-(--spacing-xs) text-heading-xxs text-(--text-default)"
			/>
			<DocCardGroup cols={cols(group.items.length)}>
				{group.items.map((architecture) => (
					<DocCard
						icon={directory.icons[group.key] ?? 'pi pi-sitemap'}
						title={architecture.label}
						href={architecture.href}
						link={directory.cardLink}
					>
						{architecture.description}
					</DocCard>
				))}
			</DocCardGroup>
		</>
	))
}
<InlineLinks prefix={directory.footer.prefix} links={directory.footer.links} />
