---
/** The documentation HOME: a directory, not a landing page. */
// It opens the way every reading page does — the column, `DocProse`, a masthead as the
// first block — with no viewport-tall band, so the sections that answer "where do I
// start" are the top of the page. Copy lives in `~/data/docs-home`.
import Button from '@aziontech/webkit/button';
import DocCard from '@aziontech/webkit/doc-card';
import DocCardGroup from '@aziontech/webkit/doc-card-group';
import FrameBox from '@aziontech/webkit/frame-box';

import CopyPromptButton from '~/components/webkit/CopyPromptButton.vue';
import InlineLinks from '~/components/homes/InlineLinks.astro';
import PixelateField from '~/components/homes/PixelateField.astro';
import SectionHeading from '~/components/homes/SectionHeading.astro';

import type { DocsHomeContent } from '~/data/docs-home';

interface Props {
	content: DocsHomeContent;
}

const { content } = Astro.props;
const { hero, interfaceSection, sections } = content;
---

{
	/*
  `data-doc-chrome` stops the prose type contract at the masthead's edge, so the h1
  and the lead take the hero scale set here. The title cap (752) is the narrowest
  container rung that holds the headline on one line at 56px; the lead sits one rung
  under it (644) so it breaks to two even lines instead of a stub.
*/
}
<header data-doc-chrome class="mb-(--spacing-12) sm:mb-(--spacing-16)">
	<h1 class="m-0 max-w-(--container-2xl) text-balance text-heading-2xl text-(--text-default)">
		{hero.title}
	</h1>
	<p
		class="m-0 mt-(--spacing-lg) max-w-(--container-xl) text-pretty text-body-lg leading-relaxed text-(--text-muted)"
	>
		{hero.description}
	</p>

	{
		/*
	  Two ways in: start reading, or hand the prompt to the tool already open. Both
	  controls keep their natural size at every width — the pill is `rounded-full` and
	  reads as a second primary when stretched — so the pair wraps instead of going fluid.
	*/
	}
	<div class="mt-(--spacing-xl)">
		<div class="flex flex-wrap items-center gap-(--spacing-sm)">
			<Button
				label={hero.buttonLabel}
				kind="primary"
				size="large"
				href={hero.buttonLink}
				class="shrink-0"
			/>
			<CopyPromptButton
				client:visible
				prompt={hero.prompt}
				label={hero.promptLabel}
				copiedLabel={hero.promptCopiedLabel}
				tooltip={hero.promptTooltip}
			/>
		</div>

		{/* In the action block, not under the masthead: it is the button's own line. */}
		<p class="mt-(--spacing-lg) max-w-(--container-2xl) text-body-sm text-(--text-muted)">
			{hero.note}
		</p>
	</div>
</header>

{
	/* Interface before objective: a reader who already knows they want the Console, the
    terminal or an agent should not read four jobs first to find the way in. */
}
<SectionHeading id={interfaceSection.heading.slug} text={interfaceSection.heading.text} />
<p>{interfaceSection.intro}</p>

{
	/*
  Both halves of one offer — "hand it the prompt" / "walk me through it" — as one
  block. 7fr/3fr is the content's own ratio: 3fr is the narrowest the right cell can
  be and still fit its button on one line.

  THE ROW IS THE FRAME, NOT THE CELLS. The cells draw no borders and the seam is the
  grid's `gap-px` showing the wrapper's border colour, so the rule is one hairline
  instead of two and the corner marks register the block once.

  `data-doc-chrome` stops the prose contract at the block's edge; `data-doc-block`
  keeps its OUTER spacing in the prose's hands, so it sits in the flow like a group.
*/
}
<FrameBox data-doc-block data-doc-chrome>
	<div class="grid gap-px bg-(--border-default) lg:grid-cols-[7fr_3fr]">
		<FrameBox borders="none" marks="none" class="bg-(--bg-canvas)">
			<div class="flex h-full flex-col items-start gap-(--spacing-md) p-(--spacing-xl)">
				<h3 id={interfaceSection.agent.id} class="text-heading-lg text-(--text-default)">
					{interfaceSection.agent.title}
				</h3>
				<p class="m-0 text-body-md text-(--text-muted)">{interfaceSection.agent.body}</p>
				<CopyPromptButton
					client:visible
					class="mt-auto"
					label={interfaceSection.agent.copyLabel}
					copiedLabel={interfaceSection.agent.copiedLabel}
					tooltip={interfaceSection.agent.tooltip}
					prompt={interfaceSection.agent.prompt}
				/>
			</div>
		</FrameBox>

		{
			/*
		  `justify-between` pins the button to the cell's floor so both cells share one
		  baseline; the slack it leaves in the shorter cell is the price of that.

		  The ground is the pixelate field at `opacity-40`, masked to one ellipse in the
		  outer corner so it fades out before it reaches the copy — a pool of light under
		  the cell, not wallpaper behind it. `overflow-hidden` is load-bearing: the field
		  is `inset-0`, and without it the grid's 1px seam shows a band of accent through.
		*/
		}
		<FrameBox
			id={interfaceSection.guided.id}
			borders="none"
			marks="none"
			class="overflow-hidden bg-(--bg-canvas)"
		>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 opacity-40 mask-[radial-gradient(90%_140%_at_100%_100%,black_0%,transparent_60%)] [--pixelate-pool-x:100%]"
			>
				<PixelateField />
			</div>

			<div
				class="relative z-10 flex h-full flex-col items-start justify-between gap-(--spacing-lg) p-(--spacing-xl) md:flex-row lg:flex-col"
			>
				<p class="m-0 text-heading-md text-(--text-default)">{interfaceSection.guided.title}</p>
				<Button
					label={interfaceSection.guided.buttonLabel}
					kind="primary"
					size="large"
					href={interfaceSection.guided.buttonHref}
				/>
			</div>
		</FrameBox>
	</div>
</FrameBox>

<DocCardGroup cols={interfaceSection.cols}>
	{
		interfaceSection.cards.map((card) => (
			<DocCard
				icon={card.icon}
				title={card.title}
				href={card.href}
				link={card.link}
				class={card.class}
			>
				{card.body}
			</DocCard>
		))
	}
</DocCardGroup>

{
	/* The five remaining sections are one shape — heading, lead, framed grid, and a
    closing sentence of onward pages — so no two of them can drift. */
}
{
	sections.map((section) => (
		<>
			<SectionHeading id={section.heading.slug} text={section.heading.text} />
			<p>{section.intro}</p>

			<DocCardGroup cols={section.cols} mobileCols={section.mobileCols}>
				{section.cards.map((card) => (
					<DocCard
						icon={card.icon}
						title={card.title}
						href={card.href}
						link={card.link}
						target={card.target}
						class={card.class}
					>
						{card.body}
					</DocCard>
				))}
			</DocCardGroup>

			{section.footer && (
				<InlineLinks prefix={section.footer.prefix} links={section.footer.links} />
			)}
		</>
	))
}
