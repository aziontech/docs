---
/**
 * The "Also useful: A, B" line that closes most sections. Astro keeps the
 * whitespace between expressions, so the separator and its link are built inside
 * one expression: no template whitespace can land before a comma, whichever way
 * the source is wrapped.
 */
import type { DocLink } from '~/data/docs-home';

interface Props {
	prefix: string;
	links: DocLink[];
}

const { prefix, links } = Astro.props;
---

<p>
	{prefix}
	{links.flatMap((link, index) => [index > 0 ? ', ' : '', <a href={link.href}>{link.label}</a>])}
</p>
