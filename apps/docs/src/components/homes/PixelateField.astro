---
/** The pixelate field: 5px squares on a 15px pitch over two pools of brand accent. */
// Ported from the design system's `PixelateBanner` (Figma "Pixelate", 12931:97258).
// The caller places it: `--pixelate-pool-x` slides the pool pair to the other edge, and
// an ancestor's `opacity` / `mask-image` holds it down to a pool of light. Plain Astro,
// not a Vue island — it is all CSS, so it costs no JavaScript.
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
	<div class="field">
		<div class="wave wave-a"></div>
		<div class="wave wave-b"></div>
	</div>
</div>

<style>
	.field {
		position: absolute;
		inset: 0;
		overflow: hidden;

		/* One cell, tiled. `mask-mode: alpha` is explicit: the tile is black, so a
		   viewer resolving `match-source` to luminance would hide every square. */
		--pixelate-tile: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='15'%20height='15'%3E%3Crect%20x='5'%20y='5'%20width='5'%20height='5'%20fill='%23000'/%3E%3C/svg%3E");

		mask-image: var(--pixelate-tile);
		mask-size: var(--pixelate-pitch, 15px) var(--pixelate-pitch, 15px);
		mask-repeat: repeat;
		mask-mode: alpha;
		-webkit-mask-image: var(--pixelate-tile);
		-webkit-mask-size: var(--pixelate-pitch, 15px) var(--pixelate-pitch, 15px);
		-webkit-mask-repeat: repeat;

		/* Two pools, measured off the Figma render: a dot peaks at 0.70 alpha of the accent
		   and bottoms out near 0.28 of that in the trough. Both sit against ONE edge, so the
		   trough is a full-height column — the bed the copy sits in. */
		/* The background-COLOUR is the floor: it keeps a dot present in the corners the
		   pools never reach, so this reads as a field and not as a blob. Both pools are the
		   accent, so it is one hue in both themes; only the ground under it flips. */
		background-color: color-mix(in srgb, var(--primary) 11%, transparent);
		background-image: radial-gradient(
				circle at var(--pixelate-pool-x, 86%) 94%,
				color-mix(in srgb, var(--primary) 74%, transparent) 0%,
				color-mix(in srgb, var(--primary) 44%, transparent) 24%,
				color-mix(in srgb, var(--primary) 18%, transparent) 52%,
				transparent 88%
			),
			radial-gradient(
				circle at var(--pixelate-pool-x, 98%) 8%,
				color-mix(in srgb, var(--primary) 50%, transparent) 0%,
				color-mix(in srgb, var(--primary) 20%, transparent) 28%,
				transparent 62%
			);
	}

	/* `repeating-linear-gradient` repeats along the gradient AXIS, so slanted bands stay
	   continuous — a tiled background would seam every period. Normal blending, not
	   `screen`: the waves must brighten on a light ground too, where `screen` toward white
	   is a no-op, while stacked translucent accent compounds alpha. */
	.wave {
		position: absolute;
		inset-block: 0;
		will-change: transform;
	}

	/* A loop is seamless only if the shift equals the pattern's period along X. Both angles
	   are 10deg off horizontal, so both stretch by the same 1 / sin(angle) = 0.98481. Each
	   element overhangs by one shift on the side it travels toward, so the field is never
	   uncovered mid-cycle. */
	.wave-a {
		--band: 380px;
		--shift: 385.86px; /* 380 / 0.98481 */
		left: 0;
		right: calc(-1 * var(--shift));
		background-image: repeating-linear-gradient(
			100deg,
			transparent 0,
			color-mix(in srgb, var(--primary) 18%, transparent) calc(var(--band) * 0.28),
			color-mix(in srgb, var(--primary) 50%, transparent) calc(var(--band) * 0.5),
			color-mix(in srgb, var(--primary) 18%, transparent) calc(var(--band) * 0.72),
			transparent var(--band)
		);
		/* The theme's duration tokens top out below a second; an ambient backdrop needs
		   periods two orders of magnitude longer, and 13s / 19s are prime so the pair only
		   re-phases every 247s. No token can express that, hence the documented exception. */
		/* stylelint-disable-next-line declaration-property-value-disallowed-list */
		animation: pixelate-wave-a 13s linear infinite;
	}

	.wave-b {
		--band: 260px;
		--shift: 264.01px; /* 260 / 0.98481 */
		left: calc(-1 * var(--shift));
		right: 0;
		background-image: repeating-linear-gradient(
			80deg,
			transparent 0,
			color-mix(in srgb, var(--primary) 14%, transparent) calc(var(--band) * 0.3),
			color-mix(in srgb, var(--primary) 38%, transparent) calc(var(--band) * 0.5),
			color-mix(in srgb, var(--primary) 14%, transparent) calc(var(--band) * 0.7),
			transparent var(--band)
		);
		/* stylelint-disable-next-line declaration-property-value-disallowed-list */
		animation: pixelate-wave-b 19s linear infinite;
	}

	@keyframes pixelate-wave-a {
		to {
			transform: translate3d(calc(-1 * var(--shift)), 0, 0);
		}
	}

	@keyframes pixelate-wave-b {
		to {
			transform: translate3d(var(--shift), 0, 0);
		}
	}

	/* Reduced motion keeps the crests — they are the picture — and only stops them
	   travelling. */
	@media (prefers-reduced-motion: reduce) {
		.wave {
			animation: none;
		}
	}
</style>
