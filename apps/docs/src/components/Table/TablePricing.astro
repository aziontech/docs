---
// @ts-nocheck
import PricingTable from '~/components/webkit/PricingTable.vue';
import { pricingRows } from '~/data/pricing';

const { metric, billing } = Astro.props;

const columns = billing;
const rows = await pricingRows(Astro.props);
---
<PricingTable metric={metric} columns={columns} rows={rows} />
