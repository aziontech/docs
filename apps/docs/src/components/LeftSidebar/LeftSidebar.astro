---
import DocsSidebar from '~/components/webkit/DocsSidebar.vue';
import { useTranslations } from '~/i18n/util';
import { getLanguageFromURL } from '~/util';
import type { Lang, SidebarModel } from '~/nav/index';
import { sidebarTreesHref } from '~/nav/resolve';

export interface Props {
	sidebar: SidebarModel;
}

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname);
const { groups, activeId, expandedIds, header, catalog, parent } = Astro.props.sidebar;
---

<!-- Before the rail paints: the collapse and width the reader left it at (keys owned by
     DocsSidebar.vue). The wrapper in BaseLayout reads both while the island is unhydrated, so the
     served rail is already theirs and hydration has nothing to correct. -->
<script is:inline>
	try {
		const root = document.documentElement;
		if (localStorage.getItem('docs-sidebar-collapsed') === 'true') {
			root.setAttribute('data-sidebar-collapsed', '');
		}
		const width = Number(localStorage.getItem('docs-sidebar-width'));
		if (Number.isFinite(width) && width > 0) {
			root.style.setProperty('--docs-sidebar-width', width + 'px');
		}
	} catch {
		// storage unavailable: the rail keeps its default
	}
</script>

<DocsSidebar
	client:idle
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	header={header}
	catalogGroups={catalog}
	parentLevel={parent}
	treesHref={sidebarTreesHref(lang as Lang)}
	backLabel={t('leftSidebar.backToDocs')}
	backToPattern={t('leftSidebar.backTo')}
	ariaLabel={t('leftSidebar.a11yTitle')}
	filterPlaceholder={t('leftSidebar.filter')}
	noMatchesLabel={t('leftSidebar.noMatches')}
/>

<!-- The row for the page being read, scrolled into the rail before it paints. The island hydrates
     over the same markup later, so the position holds; only the rail's own scroller moves. -->
<script is:inline>
	(() => {
		const island = document.currentScript && document.currentScript.previousElementSibling;
		const row = island && island.querySelector('[aria-current="page"]');
		if (!row) return;
		let scroller = row.parentElement;
		while (scroller && scroller !== island) {
			const overflow = getComputedStyle(scroller).overflowY;
			if (
				(overflow === 'auto' || overflow === 'scroll') &&
				scroller.scrollHeight > scroller.clientHeight
			)
				break;
			scroller = scroller.parentElement;
		}
		if (!scroller || scroller === island) return;
		const view = scroller.getBoundingClientRect();
		const box = row.getBoundingClientRect();
		if (box.top >= view.top && box.bottom <= view.bottom) return;
		scroller.scrollTop += box.top - view.top - (view.height - box.height) / 2;
	})();
</script>
