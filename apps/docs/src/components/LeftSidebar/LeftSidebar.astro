---
import VersionedSidebar from './VersionedSidebar.vue';
import { useTranslations } from '~/i18n/util';
import { getLanguageFromURL } from '~/util';
import type { Lang, SidebarModel } from '~/nav/index';
import { getPageAvailability } from '~/nav/index';
import { sidebarTreesHref } from '~/nav/resolve';
import type { VersionLabels } from './VersionSelect.vue';
import { PLATFORM_VERSIONS, pageVersionOf } from '~/nav/versions';
export interface Props {
	sidebar: SidebarModel;
}

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname);
const { groups, activeId, expandedIds, header, catalog, parent } = Astro.props.sidebar;

const availability = await getPageAvailability(Astro.url.pathname, lang as Lang);
// The page defines the context: the one version a single-version page covers, known at build time.
const pageVersion = pageVersionOf(availability) ?? '';
const versionLabels: VersionLabels = {
	label: t('versionSelect.label'),
	helpHeadline: t('versionSelect.helpHeadline'),
	helpTip: t('versionSelect.helpTip'),
	helpCta: t('versionSelect.helpCta'),
	helpHref: t('versionSelect.helpHref'),
	current: t('versionSelect.current'),
	short: Object.fromEntries(
		PLATFORM_VERSIONS.map((entry) => [entry.id, entry.short])
	) as VersionLabels['short'],
	stages: {
		experimental: t('versionSelect.stage.experimental'),
		preview: t('versionSelect.stage.preview'),
		deprecated: t('versionSelect.stage.deprecated'),
	},
};
---

<script is:inline define:vars={{ pageVersion }}>
	try {
		const root = document.documentElement;
		if (localStorage.getItem('docs-sidebar-collapsed') === 'true') {
			root.setAttribute('data-sidebar-collapsed', '');
		}
		// The platform version (keys owned by use-platform-version.ts). A page of a single version
		// defines it, and the choice follows; otherwise `?api=` first, then storage.
		let chosen;
		if (pageVersion) {
			chosen = pageVersion;
			root.setAttribute('data-page-version', pageVersion);
			try {
				localStorage.setItem('docs-platform-version', pageVersion);
			} catch {
				// storage blocked: the page still defines the version for this load
			}
		} else {
			const param = new URL(location.href).searchParams.get('api');
			const stored = localStorage.getItem('docs-platform-version');
			chosen = ['v3', 'v4'].includes(param) ? param : ['v3', 'v4'].includes(stored) ? stored : 'v4';
		}
		root.setAttribute('data-platform-version', chosen);
		const width = Number(localStorage.getItem('docs-sidebar-width'));
		if (Number.isFinite(width) && width > 0) {
			root.style.setProperty('--docs-sidebar-width', width + 'px');
		}
	} catch {
		// storage unavailable: the rail keeps its default
	}
</script>

<!-- The mobile drawer mounts in the header, away from this rail: it reads the same page facts here.
     `<` is escaped so the JSON can never close its own tag. -->
<script
	is:inline
	type="application/json"
	id="docs-page-availability"
	set:html={JSON.stringify({ availability, labels: versionLabels }).replace(/</g, '\u003c')}
></script>

<VersionedSidebar
	client:load
	groups={groups}
	activeId={activeId}
	initialExpanded={expandedIds}
	header={header}
	catalogGroups={catalog}
	parentLevel={parent}
	treesHref={sidebarTreesHref(lang as Lang)}
	backLabel={t('leftSidebar.backToDocs')}
	backToPattern={t('leftSidebar.backTo')}
	ariaLabel={t('leftSidebar.a11yTitle')}
	filterPlaceholder={t('leftSidebar.filter')}
	noMatchesLabel={t('leftSidebar.noMatches')}
	availability={availability}
	labels={versionLabels}
/>

<script is:inline>
	(() => {
		const island = document.currentScript && document.currentScript.previousElementSibling;
		const row = island && island.querySelector('[aria-current="page"]');
		if (!row) return;
		let scroller = row.parentElement;
		while (scroller && scroller !== island) {
			const overflow = getComputedStyle(scroller).overflowY;
			if (
				(overflow === 'auto' || overflow === 'scroll') &&
				scroller.scrollHeight > scroller.clientHeight
			)
				break;
			scroller = scroller.parentElement;
		}
		if (!scroller || scroller === island) return;
		const view = scroller.getBoundingClientRect();
		const box = row.getBoundingClientRect();
		if (box.top >= view.top && box.bottom <= view.bottom) return;
		scroller.scrollTop += box.top - view.top - (view.height - box.height) / 2;
	})();
</script>
