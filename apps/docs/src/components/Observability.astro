---
// Real User Monitoring agent: Core Web Vitals, JS errors and failed resources.
// Served by the RUM collector (POC in aziontech observability-poc). Renders nothing
// when RUM_URL is empty, so each environment opts in through env/consts.*.ts.
import { RUM_ENV, RUM_SAMPLE_RATE, RUM_URL } from '~/consts';

const release = (process.env.GITHUB_SHA ?? 'local').slice(0, 7);
---

{
	RUM_URL && (
		<script
			is:inline
			async
			src={RUM_URL}
			data-app="docs"
			data-env={RUM_ENV}
			data-release={release}
			data-sample-rate={String(RUM_SAMPLE_RATE)}
		/>
	)
}
