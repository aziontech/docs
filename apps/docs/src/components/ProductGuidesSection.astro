---
import { getLanguageFromURL } from '~/util';
import { useTranslations } from '~/i18n/util';
import { getGuidesHome, getProductFamily, type Lang } from '~/nav/index';
import ProductGuidesTable from '~/components/webkit/ProductGuidesTable.vue';

interface Props {
	product: string;
}

const { product } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const t = useTranslations(Astro);
const { entries } = await getGuidesHome('guides', lang);
const family = await getProductFamily(product);

const kinds: Record<string, string> = {
	tutorial: t('guides.kind.tutorial'),
	'how-to-guide': t('guides.kind.howToGuide'),
	'multi-product-guide': t('guides.kind.multiProductGuide'),
	'use-case': t('guides.kind.useCase'),
	architecture: t('guides.kind.architecture'),
};
const video = t('guides.format.video');
const dates = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'pt-BR', { dateStyle: 'medium' });

const rows = entries
	.filter((entry) => entry.products.some((id) => family.includes(id)))
	.map((entry) => ({
		label: entry.label,
		href: entry.href,
		external: entry.external,
		kind: [kinds[entry.kind] ?? entry.kind, entry.format === 'video' ? video : '']
			.filter(Boolean)
			.join(' · '),
		updated: entry.updated ? dates.format(new Date(entry.updated)) : '',
	}));

const labels = {
	name: t('guides.table.name'),
	type: t('guides.table.type'),
	updated: t('pageHeader.lastUpdated'),
};
---

<ProductGuidesTable rows={rows} labels={labels} />
