---
import FallbackNotice from '../FallbackNotice.astro';

import AgentPageHeader from '~/components/webkit/AgentPageHeader.vue';
import DocPageHeader from '~/components/webkit/DocPageHeader.vue';
import ReadableContent from '~/components/webkit/ReadableContent.vue';
import DocPagination from '@aziontech/webkit/doc-pagination';

import { rtlLanguages } from '~/i18n/languages';
import { normalizeLangTag } from '~/i18n/bcp-normalize';
import { useTranslations } from '~/i18n/util';

import type { CollectionEntry } from 'astro:content';

import { SITE_URL } from '~/consts';
import { getLanguageFromURL } from '~/util';
import { getBreadcrumb, getPageFacts, getPageHref, getTreeId, type Lang } from '~/nav/index';

export interface Props {
	content: {
		title: string;
		description?: string;
		page_header?: boolean;
		agent?: CollectionEntry<'docs'>['data']['agent'];
	};
	previous?: { text: string; link: string };
	next?: { text: string; link: string };
}

const { content, previous, next } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname);
const isFallback = !!Astro.params.fallback || undefined;

const title = content.title;
const bcpLang = normalizeLangTag(lang);
const direction = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
const crumbs = (await getBreadcrumb(Astro.url.pathname, lang as Lang)).map(({ label, url }) => ({
	label,
	href: url,
}));
const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
const lastUpdated = (await getPageFacts(Astro.url.pathname, lang as Lang))?.updated?.slice(0, 10);
const agentSetupHref =
	(await getTreeId(Astro.url.pathname, lang as Lang)) === 'agent-setup'
		? undefined
		: await getPageHref('documentation_agent_setup', lang as Lang);
const t = useTranslations(Astro);
const COLUMN = 'layout-column-content layout-boundary-inline';

// Structured data. The breadcrumb reuses the trail the page header renders, so a crumb and
// its schema entry cannot disagree. Google requires `item` on every ListItem but the last,
// so an unlinked grouping row (a tree node with no page of its own) is dropped rather than
// emitted without one, which would cost the page its breadcrumb eligibility; the visible
// trail still shows it. Escaping `<` keeps a title or a description from closing the
// script element. `dateModified` is deliberately absent: the page date the build resolves
// is currently the file mtime, which in CI is the checkout time, so every page would claim
// the build date. Add it once that date is the page's real last change.
const canonical = `${SITE_URL}${Astro.url.pathname}`;
const schemaCrumbs = crumbs.filter(({ href }, index) => href || index === crumbs.length - 1);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		...(schemaCrumbs.length
			? [
					{
						'@type': 'BreadcrumbList',
						itemListElement: schemaCrumbs.map(({ label, href }, index) => ({
							'@type': 'ListItem',
							position: index + 1,
							name: label,
							...(href ? { item: `${SITE_URL}${href}` } : {}),
						})),
					},
			  ]
			: []),
		{
			'@type': 'TechArticle',
			headline: title,
			...(content.description ? { description: content.description } : {}),
			inLanguage: bcpLang,
			url: canonical,
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
			publisher: { '@type': 'Organization', name: 'Azion', url: SITE_URL },
		},
	],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const headerLabels = {
	lastUpdated: t('pageHeader.lastUpdated'),
	copy: t('pageHeader.copy'),
	copied: t('pageHeader.copied'),
	copyTip: t('pageHeader.copyTip'),
	view: t('pageHeader.view'),
	viewTip: t('pageHeader.viewTip'),
	agents: t('pageHeader.agents'),
	agentsTip: t('pageHeader.agentsTip'),
};
---

<script type="application/ld+json" is:inline set:html={structuredDataJson}></script>

<div dir={isFallback ? 'ltr' : direction} lang={isFallback && 'en'}>
	<!-- {
		// For best cross-browser support of sticky or fixed elements, they must not be nested
		// inside elements that hide any overflow axis. The article hides `overflow-x`,
		// so we must place fixed UI elements like the mobile TOC here.
		Astro.slots.has('before-article') && (
			<>
				<div class="fixed-mobile-bar" dir={direction}>
					<slot name="before-article" />
				</div>
				<div class="spacer" />
			</>
		)
	} -->
	<article class="pt-(--spacing-md) pb-12">
		{
			content.page_header !== false && content.agent && (
				<AgentPageHeader
					class="doc-page-banner mb-8"
					title={title}
					breadcrumb={crumbs}
					description={content.description}
					markdownHref={markdownHref}
					locale={bcpLang}
					labels={headerLabels}
					lastUpdated={lastUpdated}
					mark={content.agent.mark}
					vendor={content.agent.vendor}
					tags={content.agent.tags}
					links={content.agent.links}
					client:load
				/>
			)
		}
		{
			content.page_header !== false && !content.agent && (
				<DocPageHeader
					class="doc-page-banner mb-8"
					title={title}
					breadcrumb={crumbs}
					description={content.description}
					markdownHref={markdownHref}
					locale={bcpLang}
					labels={headerLabels}
					lastUpdated={lastUpdated}
					agentSetupHref={agentSetupHref}
					client:load
				/>
			)
		}
		<section class={COLUMN}>
			<ReadableContent client:load>
				{
					isFallback && (
						<div lang={bcpLang} dir={direction}>
							<FallbackNotice />
						</div>
					)
				}

				<slot />
			</ReadableContent>
		</section>

		{
			(previous || next) && (
				<DocPagination
					previous={previous && { title: previous.text, href: previous.link }}
					next={next && { title: next.text, href: next.link }}
					previousLabel={t('articleNav.prevPage')}
					nextLabel={t('articleNav.nextPage')}
					class={`${COLUMN} pt-12`}
				/>
			)
		}
	</article>
</div>

<style is:global>
	.doc-page-banner {
		padding-inline: max(var(--layout-boundary-inline), (100% - var(--layout-measure-content)) / 2);
	}
</style>
