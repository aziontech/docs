---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

import PageContent from '~/components/PageContent/PageContent.astro';
import RightSidebar from '~/components/RightSidebar/RightSidebar.astro';
import PricingTableOfContents from '~/components/RightSidebar/PricingTableOfContents.vue';

import { useTranslations } from '~/i18n/util';
import { getGithubEditUrl } from '~/util/getGithubEditUrl';
import { getLanguageFromURL } from '~/util';
import { getNeighbours, type Lang } from '~/nav/index';

import BaseLayout from '~/layouts/BaseLayout.astro';

export interface Props {
	content: CollectionEntry<'docs'>['data'];
	headings: MarkdownHeading[];
	id?: String;
}

const { content, headings } = Astro.props;

const t = useTranslations(Astro);
const lang = getLanguageFromURL(Astro.url.pathname) as Lang;
const { previous, next } = await getNeighbours(Astro.url.pathname, lang);
const githubEditUrl = getGithubEditUrl(Astro);
---

<BaseLayout {...Astro.props}>
	<RightSidebar slot="secondary-sidebar" {...{ headings, githubEditUrl }}>
		<!-- The pricing outline is currency-aware: it follows the dolar/real tabs, dedupes
		     the per-currency duplicated headings and re-points anchors to the visible copy. -->
		<PricingTableOfContents
			slot="outline"
			client:idle
			headings={headings}
			labels={{
				initialHeadingTitle: t('rightSidebar.overview'),
				title: t('rightSidebar.onThisPage'),
			}}
			sharedStore="pricing-tabs"
		/>
	</RightSidebar>

	<PageContent {...{ content, previous, next }}>
		<slot />
	</PageContent>
</BaseLayout>
