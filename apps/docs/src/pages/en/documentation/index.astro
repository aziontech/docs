---
/**
 * The English docs home. It used to be `src/content/docs/en/homes/home-docs.mdx`
 * and reached this URL through `[lang]/[...slug].astro`; it is a real page now,
 * and Astro prefers this static route over the catch-all. Its metadata and copy
 * live in `~/data/docs-home`, which also feeds the synthetic collection entry
 * the docs endpoints still need.
 */
import DocsHome from '~/components/homes/DocsHome.astro';
import DocsHomeLayout from '~/layouts/DocsHomeLayout.astro';
import { docsHome } from '~/data/docs-home';

const content = docsHome.en;
---

<DocsHomeLayout
	content={content.meta}
	id={content.id}
	editFilePath={content.filePath}
	next={{ title: content.pagination.nextTitle, href: content.pagination.nextHref }}
>
	<DocsHome {content} />
</DocsHomeLayout>
