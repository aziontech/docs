{
  "name": "docs",
  "type": "module",
  "version": "2.4.2",
  "private": true,
  "scripts": {
    "consts:local": "test -f ./src/consts.ts || cp ./env/consts.localhost.ts ./src/consts.ts",
    "memory:check": "node -e 'console.log(v8.getHeapStatistics().heap_size_limit/(1024*1024))'",
    "memory:expand": "export NODE_OPTIONS='--max-old-space-size=8120'",
    "replace:links": "node ./cicd/replace-links/markdown.js",
    "dev": "pnpm run consts:local && astro dev",
    "start": "pnpm run consts:local && astro dev",
    "build": "astro build",
    "build:local": "cp ./env/consts.localhost.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:dev": "cp ./env/consts.development.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:stage": "cp ./env/consts.stage.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:prod": "cp ./env/consts.production.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:stage:azion": "pnpm run build:stage && AZION_ENV=stage azion build --skip-framework-build --config-dir azion/stage",
    "deploy:stage:azion": "cp ./env/consts.stage.ts ./src/consts.ts && AZION_ENV=stage SKIP_YARN_COREPACK_CHECK=1 azion deploy --auto --local --debug --config-dir azion/stage",
    "build:prod:azion": "pnpm run build:prod && AZION_ENV=production azion build --skip-framework-build --config-dir azion/production",
    "deploy:prod:azion": "cp ./env/consts.production.ts ./src/consts.ts && AZION_ENV=production SKIP_YARN_COREPACK_CHECK=1 azion deploy --auto --local --debug --config-dir azion/production",
    "preview": "astro preview",
    "check": "pnpm run consts:local && astro check",
    "tsc": "pnpm run consts:local && astro sync && tsc",
    "format:imports": "organize-imports-cli ./tsconfig.json",
    "add-language": "node ./scripts/add-language.mjs",
    "lint:a11y": "start-test 'pnpm run build && pnpm run preview' 3000 'pnpm run lint:a11y:local'",
    "lint:a11y:local": "pa11y-ci --sitemap 'http://localhost:3000/sitemap.xml' --sitemap-find 'https://www.azion.com' --sitemap-replace 'http://localhost:3000'",
    "lint:a11y:remote": "pa11y-ci --sitemap 'https://wwww.azion.com/sitemap.xml'",
    "lint:linkcheck": "SKIP_OG=true pnpm run build && tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-linkcheck.ts",
    "lint:linkcheck:nobuild": "NODE_OPTIONS=--max-old-space-size=8120 tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-linkcheck.ts",
    "lint:slugcheck": "node ./scripts/lint-slugcheck.mjs",
    "redirects:publish": "node ./cicd/massive-redirects/update-function-instances.mjs",
    "lint:links": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-links.ts",
    "lint:navcheck": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-navcheck.ts",
    "nav:url-map": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/url-map.ts",
    "nav:migrate": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/migrate-permalinks.ts",
    "nav:retarget": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/retarget-links.ts",
    "translation-status": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/translation-status.ts",
    "cp-doc-helpcenter": "cp -R ../docs_help_center/* src/includes/help_center/en/",
    "test:frontmatter": "node test-frontmatter.js"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.2",
    "@aziontech/icons": "^4.4.0",
    "@aziontech/theme": "5.2.2",
    "@aziontech/webkit": "5.3.0",
    "@babel/types": "^8.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-has-property": "^3.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "mermaid": "^12.3.0",
    "nanostores": "^1.5.5",
    "rehype-autolink-headings": "^7.1.0",
    "remark-smartypants": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/html-escaper": "^3.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "algoliasearch": "^4.22.1",
    "astro": "^7.4.7",
    "astro-auto-import": "^0.6.0",
    "bcp-47-normalize": "^2.1.0",
    "cssnano": "^9.9.0",
    "dedent-js": "^1.0.1",
    "domhandler": "^6.0.1",
    "fast-glob": "^3.2.11",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.3",
    "html-escaper": "^3.0.3",
    "htmlparser2": "^12.0.0",
    "kleur": "^4.1.5",
    "mdast-util-mdx-jsx": "^3.2.1",
    "mdast-util-to-string": "^4.0.0",
    "node-fetch": "^3.2.10",
    "organize-imports-cli": "^1.0.2",
    "p-retry": "^9.0.0",
    "postcss": "^8.5.32",
    "prompts": "^2.4.2",
    "remark": "^15.0.1",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "simple-git": "^4.0.2",
    "stream-json": "^3.8.0",
    "tsm": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.2.0",
    "unist-util-walker": "^1.0.0",
    "vfile": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
