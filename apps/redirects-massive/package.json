{
  "name": "redirects-massive",
  "version": "1.0.0",
  "description": "Permanent (301) redirects for the Azion docs URLs",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "DEBUG=true npx --yes edge-functions@6.1.0 dev -- --entry ./src/index.ts",
    "validate": "node src/redirects/validate.mjs",
    "build": "npx --yes edge-functions@6.1.0 build -- --entry ./src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [],
  "author": "aziontech",
  "private": true,
  "license": "ISC",
  "dependencies": {
    "azion": "3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^5.0.0",
    "edge-functions": "6.1.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^5.0.0"
  }
}
