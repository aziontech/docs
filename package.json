{
  "name": "docs-monorepo",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "dev": "pnpm -F docs run dev",
    "start": "pnpm -F docs run start",
    "build": "pnpm -F docs run build",
    "build:local": "pnpm -F docs run build:local",
    "build:dev": "pnpm -F docs run build:dev",
    "build:stage": "pnpm -F docs run build:stage",
    "build:prod": "pnpm -F docs run build:prod",
    "build:prod:azion": "pnpm -F docs run build:prod:azion",
    "deploy:prod:azion": "pnpm -F docs run deploy:prod:azion",
    "preview": "pnpm -F docs run preview",
    "check": "pnpm -F docs run check",
    "tsc": "pnpm -F docs run tsc",
    "add-language": "pnpm -F docs run add-language",
    "replace:links": "pnpm -F docs run replace:links",
    "lint:linkcheck": "pnpm -F docs run lint:linkcheck",
    "lint:linkcheck:nobuild": "pnpm -F docs run lint:linkcheck:nobuild",
    "lint:slugcheck": "pnpm -F docs run lint:slugcheck",
    "lint:links": "pnpm -F docs run lint:links",
    "lint:navcheck": "pnpm -F docs run lint:navcheck",
    "nav:url-map": "pnpm -F docs run nav:url-map",
    "nav:migrate": "pnpm -F docs run nav:migrate",
    "nav:retarget": "pnpm -F docs run nav:retarget",
    "test:frontmatter": "pnpm -F docs run test:frontmatter",
    "format:imports": "pnpm -F docs run format:imports",
    "format": "pnpm run format:code",
    "format:ci": "pnpm run format:imports && pnpm run format:code",
    "format:code": "prettier -w . --cache --plugin-search-dir=.",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"apps/docs/src/**/*.{css,scss,vue,astro}\"",
    "lint:webkit": "eslint . -f json -o .eslint-report.json || true",
    "report:webkit-adoption": "node scripts/webkit-adoption-report.mjs .eslint-report.json",
    "ci:ratchet": "node scripts/ci/ratchet.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aziontech/webkit": "5.3.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "latest",
    "globals": "^16.5.0",
    "husky": "latest",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^2.8.8",
    "prettier-plugin-astro": "^0.8.0",
    "stylelint": "^16.26.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
