{
  "name": "docs",
  "type": "module",
  "version": "1.0.1",
  "private": false,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "memory:check": "node -e 'console.log(v8.getHeapStatistics().heap_size_limit/(1024*1024))'",
    "memory:expand": "export NODE_OPTIONS='--max-old-space-size=8120'",
    "replace:links": "node ./cicd/replace-links/markdown.js",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:local": "cp ./env/consts.localhost.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:dev": "cp ./env/consts.development.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:stage": "cp ./env/consts.stage.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "build:prod": "cp ./env/consts.production.ts ./src/consts.ts && astro build && pnpm run test:frontmatter",
    "preview": "astro preview",
    "check": "astro check",
    "tsc": "astro sync && tsc",
    "format": "pnpm run format:code",
    "format:ci": "pnpm run format:imports && pnpm run format:code",
    "format:code": "prettier -w . --cache --plugin-search-dir=.",
    "format:imports": "organize-imports-cli ./tsconfig.json",
    "add-language": "node ./scripts/add-language.mjs",
    "lint:a11y": "start-test 'pnpm run build && pnpm run preview' 3000 'pnpm run lint:a11y:local'",
    "lint:a11y:local": "pa11y-ci --sitemap 'http://localhost:3000/sitemap.xml' --sitemap-find 'https://www.azion.com' --sitemap-replace 'http://localhost:3000'",
    "lint:a11y:remote": "pa11y-ci --sitemap 'https://wwww.azion.com/sitemap.xml'",
    "lint:linkcheck": "SKIP_OG=true pnpm run build && tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-linkcheck.ts",
    "lint:linkcheck:nobuild": "NODE_OPTIONS=--max-old-space-size=8120 tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-linkcheck.ts",
    "lint:slugcheck": "node ./scripts/lint-slugcheck.mjs",
    "ci:ratchet": "node scripts/ci/ratchet.mjs",
    "lint:navcheck": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/lint-navcheck.ts",
    "nav:url-map": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/url-map.ts",
    "nav:migrate": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/migrate-permalinks.ts",
    "nav:retarget": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/nav/retarget-links.ts",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue,astro}\"",
    "lint:webkit": "eslint . -f json -o .eslint-report.json || true",
    "report:webkit-adoption": "node scripts/webkit-adoption-report.mjs .eslint-report.json",
    "translation-status": "tsm --require=./scripts/lib/filter-warnings.cjs ./scripts/translation-status.ts",
    "cp-doc-helpcenter": "cp -R ../docs_help_center/* src/includes/help_center/en/",
    "test:frontmatter": "node test-frontmatter.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@actions/core": "^1.9.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^2.3.4",
    "@types/html-escaper": "^3.0.0",
    "@types/mdast": "^3.0.10",
    "@types/node": "^18.6.4",
    "@types/stream-json": "^1.7.8",
    "algoliasearch": "^4.22.1",
    "astro": "^7.2.3",
    "astro-auto-import": "^0.5.2",
    "bcp-47-normalize": "^2.1.0",
    "cssnano": "^6.0.3",
    "dedent-js": "^1.0.1",
    "domhandler": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "latest",
    "fast-glob": "^3.2.11",
    "globals": "^16.5.0",
    "hast-util-to-html": "^8.0.4",
    "hast-util-to-string": "^2.0.0",
    "hastscript": "^7.0.2",
    "html-escaper": "^3.0.3",
    "htmlparser2": "^7.2.0",
    "husky": "latest",
    "kleur": "^4.1.5",
    "mdast-util-mdx-jsx": "^2.1.2",
    "mdast-util-to-string": "^3.1.1",
    "node-fetch": "^3.2.10",
    "organize-imports-cli": "^0.10.0",
    "p-retry": "^5.1.1",
    "postcss": "^8.5.28",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^2.8.8",
    "prettier-plugin-astro": "^0.8.0",
    "prompts": "^2.4.2",
    "remark": "^14.0.2",
    "remark-directive": "^2.0.1",
    "simple-git": "^3.36.0",
    "stream-json": "^1.8.0",
    "stylelint": "^16.26.1",
    "tsm": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.70.0",
    "unified": "^10.1.2",
    "unist-util-remove": "^3.1.0",
    "unist-util-visit": "^4.1.0",
    "unist-util-walker": "^1.0.0",
    "vfile": "^5.3.6",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.2",
    "@aziontech/icons": "^4.1.1",
    "@aziontech/theme": "5.0.0",
    "@aziontech/webkit": "5.0.0",
    "@babel/types": "^7.22.19",
    "@tailwindcss/vite": "^4.3.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-has-property": "^3.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "nanostores": "^0.10.3",
    "rehype-autolink-headings": "^7.1.0",
    "remark-smartypants": "^2.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  }
}
